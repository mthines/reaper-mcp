    );
    // Alt (Option)-drag erases every note the pointer crosses, like REAPER's MIDI editor
    hov && ui_press && ui_active == 0 && (mouse_cap & 16) ? (
      ui_press = 0; ui_active = 66; ui_sqmode = 8; ui_sqln = ln; ui_sqi = 0;
