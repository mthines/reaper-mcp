          ui_sqmode = 2; ui_sqs0 = k[0]; ui_sqpush1();
          ui_sqsl[ui_sqln * 32 + i] ? 0 : ( ui_sqdesel(); ui_sqsl[ui_sqln * 32 + i] = 1; );
          ui_sqorg();
        );
