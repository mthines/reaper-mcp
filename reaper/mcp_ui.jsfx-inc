// mcp_ui.jsfx-inc: the reaper-mcp @gfx toolkit, v1.4.0
//
// Canonical source. `write_jsfx` pastes the body below (everything after this header) into the
// plugin's own @init section, so a generated plugin is ONE file with no dependency on this one,
// the bridge or the MCP server. Edit it here, never in a generated plugin.
//
// Principles: fast (redraw only when something changed, no allocation in @gfx, coefficients
// belong in the plugin's update()), simple (few widgets), progressive disclosure (a core view
// that fills the window and never moves, an Advanced drawer that slides up over it).
// Every plugin shows its name, small and spaced, top-left (ui_name; a window under 150 px hides it).
//
// Gestures on a knob (the FabFilter/Serum convention): drag up/down, Shift-drag = 10x finer,
// wheel (Shift = finer), double-click = type a value, Cmd-click / Ctrl-click / Alt-click = reset
// to the default. Toggles and choices: click; a modifier-click resets them too.
// Esc: REAPER closes the FX window on Esc before the plugin sees it. Only with the FX window's
// "+" menu > "Send all keyboard input to plug-in" does Esc reach the plugin; then it closes the
// value box, the About dialog or the drawer (and the window closes with its close button).
//
// Memory map (indexes into the plugin's memory; the plugin's own buffers start at ui_mem):
//   0..1023     toolkit core: slider metadata (ui_min/ui_max/ui_def/ui_stp, 65 each), meters (ui_mtr)
//   1024..1151  ui_fg   frequency graph trace, ui_gn (96) points in dB, log-spaced 20 Hz..20 kHz
//   1152..1167  ui_ge   band edges: the slider index of each draggable handle (16)
//   1168..1199  ui_grm  gain reduction per band in dB (8) -- slots 8..31 spare
//   1200..1327  ui_kb   MIDI keyboard: velocity per note 0..127 (0 = off)
//   1328..1455  ui_fi   the input trace for the before/after view (same 96 points as ui_fg)
//   1456..1489  ui_kq   the keys played with the mouse: 16 note/velocity slots, then head and tail (ui_kpoll)
//   1490..1505  ui_pd   the pads: when a key-struck pad lets go (time_precise), 0 = held or off (ui_pads)
//   1520..1775  ui_sqsl the sequencer's selected notes (lane * 32 + note), 1 = selected (ui_seq)
//   1776..2031  ui_sqor where the selected notes started when a drag began (ui_seq)
//   1506..1519 and 2032..2047  spare for the toolkit
//   2048..      ui_mem  the plugin
// Every global starts with ui_. Sliders must be UNNAMED (slider1:0.5<0,1,0.01>Label): named
// sliders do not keep their value in sliderN, which the toolkit reads through slider(idx).
// EEL2: max()/min() take exactly two arguments; no 1e-9 style literals.
//
// Redraw: ui_boot(0) draws only when a slider or the mouse changed; ui_boot(1) redraws every frame
// (a ui_meter needs it); ui_boot(2) is activity-driven: the graph feeds below (ui_gfeed, ui_gset,
// ui_gr, ui_glevel, ui_kkey) mark the UI dirty only when a value moved by a visible step, so a
// plugin with a spectrum, gain-reduction bars and a keyboard stays idle on silence.
//
// Plugin side:
//   @init      ... ui_boot(animated);   // 0 static, 1 every frame (ui_meter), 2 activity-driven
//   @block     ui_changed() ? update(); // a slider moved by a click or drag in @gfx
//   @gfx 380 220
//   ui_begin(core_rows, adv_rows) ? (
//     ui_row(3); ui_knob(1, "Mix", 2); ui_knob(2, "Size", 2); ui_toggle(3, "Freeze");
//     ui_section("Advanced") ? ( ui_row(2); ui_knob(4, "Damping", 2); ui_knob(5, "Pre-delay", 4); );
//     ui_end();
//   );
//   @serialize file_var(0, ui_adv_open);   // added for you when the plugin has none

ui_ver = 1.3;
ui_hm = 0; ui_ho = 0;   // the header bars' sliders (ui_header), 0 = none

// Design tokens: the bridge status page's palette (apps/bridge-ui/src/styles.css). The accent is
// the plugin's own: write_jsfx emits ui_theme($xRRGGBB) after this block (from the plugin's name,
// or the colour the user picked). Plugin code never sets it.
ui_cBg = $x0e0f11;   ui_cPanel = $x15171a;  ui_cPanel2 = $x1b1d21;  ui_cLine = $x24272c;
ui_cText = $xe7e9ec; ui_cMuted = $x8a909a;  ui_cAccent = $x7cc4ff;  ui_cLive = $x4ade80;
ui_cWarn = $xf5b84b; ui_cBad = $xf87171;

// The footer credit (bottom right). 0 hides it. A click opens the About dialog (JSFX cannot open
// a browser or write the clipboard, so it shows the repository address as text).
ui_credit = 1;
// 1 hides REAPER's slider panel above the UI (it duplicates the knobs and squeezes them). The
// sliders stay real parameters: automation, MIDI learn and the Param menu still list them.
ui_hide_sliders = 1;
// 1 = a very subtle vertical gradient (tinted by the accent) with fine film grain behind the UI,
// rendered once into an offscreen image and blitted; 0 = a flat background.
ui_texture = 1;
ui_grain = 0.3;        // grain strength: the tile is bg-level noise of +/-0.06, blended at this opacity
ui_img_bg = 120; ui_img_tile = 121;

// Filled in by write_jsfx's metadata block (shown in the About dialog): never the user's request.
strcpy(#ui_name, "Plugin"); strcpy(#ui_date, ""); strcpy(#ui_tkv, "1.4.0");
ui_pver = 0; ui_nctl = 0; ui_akind = 0; ui_example = 0;

// Per-slider metadata (index 1..64), filled by write_jsfx from the slider lines.
ui_min = 0; ui_max = 65; ui_def = 130; ui_stp = 195;
ui_mtr = 400;          // meter state: 2 slots per meter (level in dB, last time)
ui_gn = 96;            // frequency graph trace points (log-spaced); at most 128
ui_fg = 1024; ui_ge = 1152; ui_grm = 1168; ui_kb = 1200; ui_fi = 1328; ui_kq = 1456; ui_pd = 1490; ui_gt = ui_fg;   // graph widgets' memory, see the map above
ui_mem = 2048;         // first free memory index for the plugin's own buffers
// Drum pads (ui_pads): the bank's first note, size and shape, set by the widget; ui_keys reads them every frame.
ui_pn = 36; ui_pc = 0; ui_pcols = 4; ui_prows = 4;
// Computer keys for the pads, bottom row first (pad 1 is bottom-left, like an MPC); needs REAPER's
// "Send all keyboard input to plug-in" and the FX window focused. Shift = a hard hit.
strcpy(#ui_pkeys, "zxcvasdfqwer1234");
strcpy(#ui_pword, "PAD");   // what ui_padmap calls a cell: ui_seq makes it LANE
// Step sequencer (ui_seq): the plugin's buffer, lane count and loop length, set by the widget; ui_sqon = lanes drawn (0 = none)
ui_sqon = 0; ui_sqsl = 1520; ui_sqor = 1776;
ui_tipn = 0; ui_tipf = 0; ui_tipt = 0; ui_tipx = 0; ui_tipy = 0;   // the knob tooltip: hovered slider, its frame flag, since when, where
ui_sqph = -1;   // the playhead in loop ticks, -1 = stopped: the plugin sets it in @block
// REAPER re-runs @init when playback starts (and on sample-rate changes): the UI state below
// is set once, so pressing Play never closes the drawer or drops a drag. Plugin code must not
// assign ui_adv_open either (only @serialize's file_var restores it).
ui_ready ? ( ui_hash = -1; ) : (
  ui_adv_open = 0;     // Advanced drawer open (saved with the project and presets)
  ui_hash = -1;
  ui_p = -1;           // drawer position 0..1 (animated); -1 = not drawn yet
  ui_ed = 0;           // slider whose value box is open (typing a value), 0 = none
  ui_about = 0;        // About dialog open
  ui_glv = -90;        // live level for the transfer curve (-90 = none)
  ui_fsel = 0;         // selected band of the frequency graph (the plugin reads it)
  ui_gi = 0; loop(128, ui_fg[ui_gi] = -120; ui_fi[ui_gi] = -120; ui_gi += 1;); ui_fcmp = 0;   // an empty trace
  ui_pheld = 0;        // the pad held with the mouse, 1-based, 0 = none
  ui_sqbl = 2; ui_sqbf = 0;   // the sequencer's brush: length 0..3 (1/4 1/8 1/16 1/32) and feel 0..2 (straight, triplet, dotted)
  ui_sqb = 0; ui_sqnl = 4;   // the buffer and lane count survive the @init rerun on Play, like the pattern in them
  ui_sqmode = 0; ui_sqcid = -1; ui_sqct = 0; ui_sqsure = 0;
  ui_squh = 0; ui_squn = 0; ui_sqrh = 0; ui_sqrn = 0; ui_sqpd = 0;   // undo history: next slot and depth of the undo and redo rings
  ui_ready = 1;
);

function ui_meta(idx, lo, hi, df, st) (
  ui_min[idx] = lo; ui_max[idx] = hi; ui_def[idx] = df; ui_stp[idx] = st;
);

function ui_boot(animated) (
  gfx_ext_retina = 1;
  gfx_clear = -1;
  ui_animated = animated;
  ui_hide_sliders ? slider_show(4294967295, 0);
);

// A slider moved from @gfx: returns 1 once, so @block can re-run the plugin's update().
function ui_changed() local(r) ( r = ui_chg; ui_chg = 0; r; );

function ui_c(c, a) local(r, g, b) (
  r = floor(c / 65536) & 255; g = floor(c / 256) & 255; b = c & 255;
  gfx_set(r / 255, g / 255, b / 255, a);
);

// The mix of two packed colours as a packed colour (t = 0: c1, 1: c2).
function ui_mixc(c1, c2, t) (
  floor((floor(c1 / 65536) & 255) * (1 - t) + (floor(c2 / 65536) & 255) * t + 0.5) * 65536
  + floor((floor(c1 / 256) & 255) * (1 - t) + (floor(c2 / 256) & 255) * t + 0.5) * 256
  + floor((c1 & 255) * (1 - t) + (c2 & 255) * t + 0.5);
);

// The plugin's accent and every token derived from it, computed once (not per frame).
function ui_theme(c) (
  ui_cAccent = c;
  ui_cAccentHi = ui_mixc(c, ui_cText, 0.18);          // hover
  ui_cAccentAct = ui_mixc(c, ui_cText, 0.35);         // dragging
  ui_cTrack = ui_mixc(ui_mixc(ui_cLine, ui_cMuted, 0.12), c, 0.07);
  ui_cTrackHot = ui_mixc(ui_mixc(ui_cLine, ui_cMuted, 0.22), c, 0.12);
  ui_cTop = ui_mixc(ui_mixc(ui_cBg, $xffffff, 0.012), c, 0.02); // gradient: a hair lighter (and tinted) on top,
  ui_cBot = ui_mixc(ui_cBg, 0, 0.15);                             // a hair darker at the bottom
);
ui_theme($x7cc4ff);

// Opaque mix of two colors (t = 0: c1, 1: c2): blending without alpha, so shapes never seam.
function ui_cm(c1, c2, t) local(r, g, b) (
  r = (floor(c1 / 65536) & 255) * (1 - t) + (floor(c2 / 65536) & 255) * t;
  g = (floor(c1 / 256) & 255) * (1 - t) + (floor(c2 / 256) & 255) * t;
  b = (c1 & 255) * (1 - t) + (c2 & 255) * t;
  gfx_set(r / 255, g / 255, b / 255, 1);
);

function ui_q(idx, v) local(lo, hi, st) (
  lo = ui_min[idx]; hi = ui_max[idx]; st = ui_stp[idx];
  st > 0 ? v = lo + floor((v - lo) / st + 0.5) * st;
  min(hi, max(lo, v));
);

function ui_set(idx, v) (
  v != slider(idx) ? (
    slider(idx) = v;
    slider_automate(2 ^ (idx - 1));
    ui_chg = 1;
  );
);

// ---- drawing helpers ----------------------------------------------------------------------

// Filled rounded rectangle (opaque colors only: the corners overlap the sides).
function ui_rrect(x, y, w, h, r) (
  r = min(r, min(w, h) / 2);
  gfx_rect(x + r, y, w - 2 * r, h);
  gfx_rect(x, y + r, r, h - 2 * r);
  gfx_rect(x + w - r, y + r, r, h - 2 * r);
  gfx_circle(x + r, y + r, r, 1, 1);         gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1); gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);

// One solid stroke along a circle: a ring segment filled as quads, its edges anti-aliased,
// round caps. Angles in radians, 0 = 12 o'clock, clockwise.
function ui_ring(cx, cy, r0, r1, a0, a1) local(n, d, a, b, ra, rb) (
  n = max(2, ceil(abs(a1 - a0) / 0.07)); d = (a1 - a0) / n; a = a0;
  loop(n,
    b = a + d;
    gfx_triangle(cx + sin(a) * r1, cy - cos(a) * r1, cx + sin(b) * r1, cy - cos(b) * r1,
                 cx + sin(b) * r0, cy - cos(b) * r0, cx + sin(a) * r0, cy - cos(a) * r0);
    a = b;
  );
  gfx_arc(cx, cy, r1, a0, a1, 1); gfx_arc(cx, cy, r1 - 0.5, a0, a1, 1);
  gfx_arc(cx, cy, r0, a0, a1, 1); gfx_arc(cx, cy, r0 + 0.5, a0, a1, 1);
  ra = (r1 - r0) / 2; rb = (r0 + r1) / 2;
  gfx_circle(cx + sin(a0) * rb, cy - cos(a0) * rb, ra, 1, 1);
  gfx_circle(cx + sin(a1) * rb, cy - cos(a1) * rb, ra, 1, 1);
);

// #ui_txt = the label in capitals (drawn small and muted above each widget)
function ui_caps(s) local(i, c) (
  strcpy(#ui_txt, s); i = 0;
  loop(strlen(#ui_txt), c = str_getchar(#ui_txt, i); (c >= 97 && c <= 122) ? str_setchar(#ui_txt, i, c - 32); i += 1;);
);

function ui_ctext(x, y, w, h) (
  gfx_measurestr(#ui_txt, ui_tw, ui_th);
  gfx_x = x + (w - ui_tw) / 2; gfx_y = y + (h - ui_th) / 2;
  gfx_drawstr(#ui_txt);
);

function ui_chev(cx, cy, up) local(d, k) (
  d = 4 * ui_s; k = 0;
  loop(2,
    gfx_line(cx - d, cy + (up ? d / 2 : -d / 2) + k, cx, cy + (up ? -d / 2 : d / 2) + k, 1);
    gfx_line(cx, cy + (up ? -d / 2 : d / 2) + k, cx + d, cy + (up ? d / 2 : -d / 2) + k, 1);
    k += 1;
  );
);

// The background image: gradient + grain, built on the first frame and when the window size or
// the accent changes, never per frame. The grain is one 128 px tile of noise made once and tiled.
function ui_bgbuild() local(x, y, v, m, rt, gt, bt) (
  !ui_tiled ? (
    // Noise centred on the background's own level, so blending it never lifts or dims the page.
    m = ((floor(ui_cBg / 65536) & 255) + (floor(ui_cBg / 256) & 255) + (ui_cBg & 255)) / 765;
    gfx_setimgdim(ui_img_tile, 128, 128); gfx_dest = ui_img_tile;
    y = 0; loop(128, x = 0; loop(128, v = m + (rand(1) - 0.5) * 0.12; gfx_x = x; gfx_y = y; gfx_setpixel(v, v, v); x += 1;); y += 1;);
    ui_tiled = 1;
  );
  gfx_setimgdim(ui_img_bg, gfx_w, gfx_h); gfx_dest = ui_img_bg;
  rt = (floor(ui_cTop / 65536) & 255) / 255; gt = (floor(ui_cTop / 256) & 255) / 255; bt = (ui_cTop & 255) / 255;
  gfx_gradrect(0, 0, gfx_w, gfx_h, rt, gt, bt, 1, 0, 0, 0, 0,
    ((floor(ui_cBot / 65536) & 255) / 255 - rt) / gfx_h, ((floor(ui_cBot / 256) & 255) / 255 - gt) / gfx_h, ((ui_cBot & 255) / 255 - bt) / gfx_h, 0);
  gfx_mode = 6; gfx_a = ui_grain;   // 2: ignore the tile's alpha, 4: no filtering (crisp grain)
  y = 0; loop(ceil(gfx_h / 128), x = 0; loop(ceil(gfx_w / 128), gfx_blit(ui_img_tile, 1, 0, 0, 0, 128, 128, x, y, 128, 128); x += 128;); y += 128;);
  gfx_mode = 0; gfx_a = 1; gfx_dest = -1;
  ui_bgw = gfx_w; ui_bgh = gfx_h; ui_bgc = ui_cTop;
);

function ui_bg() (
  ui_texture ? (
    (gfx_w != ui_bgw || gfx_h != ui_bgh || ui_bgc != ui_cTop) ? ui_bgbuild();
    gfx_x = 0; gfx_y = 0; gfx_mode = 6; gfx_a = 1;
    gfx_blit(ui_img_bg, 1, 0);
    gfx_mode = 0;
  ) : (
    ui_c(ui_cBg, 1); gfx_rect(0, 0, gfx_w, gfx_h);
  );
);

// ---- typing a value ------------------------------------------------------------------------

// The value box's text: the value in the knob's display units, without the unit.
function ui_fmted(fmt, v) (
  fmt == 1 ? sprintf(#ui_edt, "%.1f", v) :
  fmt == 2 ? sprintf(#ui_edt, "%.0f", v * 100) :
  (fmt == 3 || fmt == 4) ? sprintf(#ui_edt, "%.0f", v) :
  fmt == 5 ? sprintf(#ui_edt, "%d", v) :
  sprintf(#ui_edt, "%.2f", v);
);

function ui_edopen(idx, fmt, label, x, y) (
  ui_ed = idx; ui_edfmt = fmt; ui_edx = x; ui_edy = y; ui_edsel = 1;
  strcpy(#ui_edl, label); ui_fmted(fmt, slider(idx));
  while (gfx_getchar() > 0) ( 0; );   // keys typed before the box opened are not part of the value
  ui_active = 0; ui_lci = 0; ui_press = 0;
);

// Enter: read the typed number (digits, one '.', '-', a 'k' = x1000), percent knobs store a
// fraction, then clamp and snap it like a drag would. Nothing typed = nothing changes.
function ui_edcommit() local(i, c, v, sg, fr, d, k, any) (
  i = 0; v = 0; sg = 1; fr = 0; d = 1; k = 1; any = 0;
  loop(strlen(#ui_edt),
    c = str_getchar(#ui_edt, i);
    c == 45 ? sg = -sg :
    c == 46 ? fr = 1 :
    c == 107 ? k = 1000 :
    (c >= 48 && c <= 57) ? ( any = 1; fr ? ( d *= 0.1; v += (c - 48) * d; ) : v = v * 10 + c - 48; );
    i += 1;
  );
  any ? (
    v *= sg * k;
    ui_edfmt == 2 ? v /= 100;
    ui_set(ui_ed, ui_q(ui_ed, v)); slider_automate(2 ^ (ui_ed - 1), 1);
  );
  ui_ed = 0;
);

function ui_edkey(c) (
  c == 13 ? ui_edcommit() :
  c == 8 ? (
    ui_edsel ? strcpy(#ui_edt, "") : strlen(#ui_edt) > 0 ? str_delsub(#ui_edt, strlen(#ui_edt) - 1, 1);
    ui_edsel = 0;
  ) :
  ((c >= 48 && c <= 57) || c == 46 || c == 45 || ((c == 107 || c == 75) && ui_edfmt == 3)) ? (
    ui_edsel ? strcpy(#ui_edt, ""); ui_edsel = 0;
    strlen(#ui_edt) < 12 ? ( sprintf(#ui_tmp, "%c", c == 75 ? 107 : c); strcat(#ui_edt, #ui_tmp); );
  );
);

// Keys are read only while a layer is open. Esc (only delivered with "Send all keyboard input
// to plug-in") closes the top layer: value box, then About, then the drawer.
// A MIDI note on (vel 1..127) or off (vel 0), from @block's midirecv loop.
function ui_kkey(note, vel) local(n, q0, q1) (
  n = min(127, max(0, floor(note)));
  q0 = ui_kb[n] > 0; q1 = vel > 0;
  ui_fh3 += (q1 - q0) * (n + 1);
  ui_kb[n] = q1 ? min(127, max(1, vel)) : 0;
);

// The keys the user plays with the mouse reach @block through a small queue (ui_kq: 16 slots of note and
// velocity, then a head and a tail). ui_kput is called by the keyboard widget; the plugin calls ui_kpoll() in
// @block until it returns 0: each 1 means ui_kn is a note and ui_kv its velocity (0 = note off).
// A note-on is queued only while two slots are free, so every queued note-on keeps room for its note-off
// (a full queue drops the newest event; a lost note-off would leave the note stuck when @block resumes).
function ui_kput(note, vel) local(t, f) (
  t = (ui_kq[33] + 1) % 16;
  f = (ui_kq[32] - ui_kq[33] + 15) % 16;   // free slots
  f >= (vel > 0 ? 2 : 1) ? ( ui_kq[ui_kq[33] * 2] = note; ui_kq[ui_kq[33] * 2 + 1] = vel; ui_kq[33] = t; );
);
function ui_kpoll() (
  ui_kq[32] != ui_kq[33] ? (
    ui_kn = ui_kq[ui_kq[32] * 2]; ui_kv = ui_kq[ui_kq[32] * 2 + 1];
    ui_kq[32] = (ui_kq[32] + 1) % 16;
    1;
  ) : 0;
);

// A pad on (vel 1..127) or off for pad i (0-based, bottom-left first): queued for the plugin's ui_kpoll() like a
// played key and lit like a note from MIDI. The note is ui_pn + i.
function ui_padon(i, vel) local(n) (
  n = ui_pn + i; ui_kput(n, vel); ui_kkey(n, vel); ui_pd[i] = 0;
);
function ui_padoff(i) local(n) (
  n = ui_pn + i; ui_kput(n, 0); ui_kkey(n, 0); ui_pd[i] = 0;
);
// The pad a typed character strikes, -1 for none. The keys are a 4 x 4 block (zxcv / asdf / qwer / 1234, bottom
// row first); a smaller grid uses its bottom-left corner of it.
function ui_padkey(c) local(k, q, col, row) (
  k = -1; q = 0;
  loop(16, str_getchar(#ui_pkeys, q) == c ? k = q; q += 1;);
  col = k % 4; row = floor(k / 4);
  (k >= 0 && col < ui_pcols && row < ui_prows) ? row * ui_pcols + col : -1;
);

// ---- the sequencer's selection (lives next to the keys: ui_sqkey uses it) ----------------------
// Flags per note (lane * 32 + index) in ui_sqsl; a note's index shifts when another is deleted (the last takes its
// place), so ui_sqdel moves the flag with it.
function ui_sqdesel() local(i) ( i = 0; loop(256, ui_sqsl[i] = 0; i += 1;); );
function ui_sqselall() local(l, i, p) (
  ui_sqdesel(); l = 0;
  loop(ui_sqnl, p = ui_sqb + 8 + l * 98; i = 0; loop(p[0], ui_sqsl[l * 32 + i] = 1; i += 1;); l += 1;);
);
// Undo history: 100 snapshots of the pattern (everything but the loop length, which a slider owns), kept in the
// plugin's memory after its own buffers: buf + 1200 and 158400 numbers on (an undo ring, then a redo ring, 792 a slot).
// ui_sqpush() before every change; ui_sqpush1() once per gesture (ui_seq clears the flag when the mouse lets go).
function ui_squbase(r, slot) ( ui_sqb + 1200 + (r * 100 + slot) * 792; );
function ui_sqpush() (
  memcpy(ui_squbase(0, ui_squh) + 1, ui_sqb + 1, 791);
  ui_squh = (ui_squh + 1) % 100; ui_squn = min(100, ui_squn + 1); ui_sqrn = 0;
);
function ui_sqpush1() ( ui_sqpd ? 0 : ( ui_sqpush(); ui_sqpd = 1; ); );
function ui_squndo() (
  ui_squn > 0 ? (
    memcpy(ui_squbase(1, ui_sqrh) + 1, ui_sqb + 1, 791);
    ui_sqrh = (ui_sqrh + 1) % 100; ui_sqrn = min(100, ui_sqrn + 1);
    ui_squh = (ui_squh + 99) % 100; ui_squn -= 1;
    memcpy(ui_sqb + 1, ui_squbase(0, ui_squh) + 1, 791);
    ui_sqdesel();
  );
);
function ui_sqredo() (
  ui_sqrn > 0 ? (
    memcpy(ui_squbase(0, ui_squh) + 1, ui_sqb + 1, 791);
    ui_squh = (ui_squh + 1) % 100; ui_squn = min(100, ui_squn + 1);
    ui_sqrh = (ui_sqrh + 99) % 100; ui_sqrn -= 1;
    memcpy(ui_sqb + 1, ui_squbase(1, ui_sqrh) + 1, 791);
    ui_sqdesel();
  );
);
// Removes every selected note (from the end, so a note moved into a hole has already been looked at).
function ui_sqdelsel() local(l, i, p, k, n) (
  n = 0; l = 0;
  loop(ui_sqnl, p = ui_sqb + 8 + l * 98; i = 0; loop(p[0], n += ui_sqsl[l * 32 + i] ? 1 : 0; i += 1;); l += 1;);
  n > 0 ? ui_sqpush1();
  l = 0;
  loop(ui_sqnl,
    p = ui_sqb + 8 + l * 98; i = p[0] - 1;
    loop(p[0],
      i >= 0 && ui_sqsl[l * 32 + i] ? (
        k = p[0] - 1;
        p[2 + i * 3] = p[2 + k * 3]; p[3 + i * 3] = p[3 + k * 3]; p[4 + i * 3] = p[4 + k * 3];
        ui_sqsl[l * 32 + i] = ui_sqsl[l * 32 + k]; ui_sqsl[l * 32 + k] = 0;
        p[0] = k;
      );
      i -= 1;
    );
    l += 1;
  );
);

// The sequencer's typed keys (REAPER's "Send all keyboard input to plug-in"): 1-4 set the brush length, q / w / e its
// feel, Delete or Backspace removes the selected notes, Cmd/Ctrl+A selects all.
function ui_sqkey(c) (
  (c == 6579564 || c == 8) ? ( ui_sqdelsel(); ui_edv += 1; ) :
  c == 1 ? ( ui_sqselall(); ui_edv += 1; ) :
  c == 26 ? ( (mouse_cap & 8) ? ui_sqredo() : ui_squndo(); ui_edv += 1; ) :
  c == 25 ? ( ui_sqredo(); ui_edv += 1; ) :
  (c == 122 || c == 90) && (mouse_cap & 36) ? ( (mouse_cap & 8) ? ui_sqredo() : ui_squndo(); ui_edv += 1; ) :
  c >= 65 && c <= 90 ? c += 32;
  c >= 49 && c <= 52 ? ( ui_sqbl = c - 49; ui_edv += 1; ) :
  c == 113 ? ( ui_sqbf = 0; ui_edv += 1; ) :
  c == 119 ? ( ui_sqbf = 1; ui_edv += 1; ) :
  c == 101 ? ( ui_sqbf = 2; ui_edv += 1; );
);

function ui_keys() local(c, i, now, vel) (
  // a pad struck from the keyboard lets go 0.12 s later (a drum is a one-shot)
  ui_pc > 0 ? (
    now = time_precise();
    i = 0; loop(ui_pc, ui_pd[i] > 0 && now >= ui_pd[i] ? ui_padoff(i); i += 1;);
  );
  (ui_ed || ui_about) ? (
    c = gfx_getchar();
    while (c > 0) (
      c == 27 ? ( ui_ed ? ui_ed = 0 : ui_about = 0; ) : ui_ed ? ui_edkey(c);
      ui_edv += 1;
      c = gfx_getchar();
    );
  ) : (ui_adv_open || ui_pc > 0 || ui_sqon > 0) ? (
    // the drawer being open does not stop the pad keys: you can hear a pad while you map it
    c = gfx_getchar();
    while (c > 0) (
      c == 27 ? ( ui_adv_open = 0; ui_edv += 1; ) : ui_sqon > 0 ? ui_sqkey(c) : ui_pc > 0 ? (
        vel = (c >= 65 && c <= 90) ? 127 : 100;
        (c >= 65 && c <= 90) ? c += 32;
        i = ui_padkey(c);
        i >= 0 && ui_pheld != i + 1 ? ( ui_padon(i, vel); ui_pd[i] = now + 0.12; );
      );
      c = gfx_getchar();
    );
  );
);

// ---- layout -------------------------------------------------------------------------------

// The plugin's name, small and spaced capitals with an accent dot, top-left in the padding above the
// first row. Drawn first, so the Advanced drawer and its dimming sit over it like over the core view.
function ui_namedraw() local(x, y, i, c, n) (
  gfx_w >= 150 * ui_s ? (
    gfx_setfont(5);
    ui_caps(#ui_name);
    gfx_measurestr("A", ui_tw, ui_th);
    x = ui_pad; y = 15 * ui_s - ui_th / 2;   // centred on the header band, level with the Mix / Output bars
    ui_c(ui_cAccent, 0.9); gfx_circle(x + 1.5 * ui_s, 15 * ui_s, 1.5 * ui_s, 1, 1);
    x += 8 * ui_s;
    ui_c(ui_cMuted, 0.85);
    i = 0; n = strlen(#ui_txt);
    loop(n,
      x < ui_nlim ? (
        c = str_getchar(#ui_txt, i);
        c == 32 ? ( x += 5 * ui_s; ) : (
          sprintf(#ui_tmp, "%c", c);
          gfx_x = x; gfx_y = y; gfx_drawstr(#ui_tmp);
          gfx_measurestr(#ui_tmp, ui_tw, ui_th);
          x += ui_tw + 1.6 * ui_s;
        );
      );
      i += 1;
    );
    gfx_setfont(1);
  );
);


// The footer credit: "reaper-mcp" in the bottom-right corner; a click opens the About dialog.
// Hidden in a narrow window.
function ui_footer(y, h) local(x, hit) (
  ui_credit && gfx_w >= 240 * ui_s ? (
    gfx_setfont(2); strcpy(#ui_txt, "reaper-mcp"); gfx_measurestr(#ui_txt, ui_tw, ui_th);
    x = gfx_w - ui_pad - ui_tw - (ui_bar > 0 ? 26 * ui_s : 0);
    hit = mouse_x >= x - 4 * ui_s && mouse_x < x + ui_tw + 4 * ui_s && mouse_y >= y && mouse_y < y + h && !ui_modal;
    ui_c(hit ? ui_cAccent : ui_cMuted, hit ? 1 : 0.55);
    gfx_x = x; gfx_y = y + (h - ui_th) / 2; gfx_drawstr(#ui_txt);
    hit != ui_cur ? ( gfx_setcursor(hit ? 32649 : 32512); ui_cur = hit; );
    hit && ui_press ? ( ui_about = 1; ui_press = 0; );
    gfx_setfont(1);
    hit;
  ) : 0;
);

// A panel floating over everything: shadow, hairline, fill.
function ui_float(x, y, w, h) local(k) (
  k = 0; loop(5, ui_c(0, 0.07 * (5 - k)); ui_rrect(x - k * ui_s, y - k * ui_s + 2 * ui_s, w + 2 * k * ui_s, h + 2 * k * ui_s, 10 * ui_s + k * ui_s); k += 1;);
  ui_c(ui_cLine, 1); ui_rrect(x - ui_s, y - ui_s, w + 2 * ui_s, h + 2 * ui_s, 10 * ui_s);
  ui_c(ui_cPanel, 1); ui_rrect(x, y, w, h, 9 * ui_s);
);

// The value box next to a knob: type, Enter sets it. A click outside it cancels.
function ui_popover() local(w, h, x, y, fx, fy, fw, fh, tx) (
  w = 132 * ui_s; h = 62 * ui_s;
  x = min(gfx_w - w - 6 * ui_s, max(6 * ui_s, ui_edx - w / 2));
  y = ui_edy + 14 * ui_s; y + h > gfx_h - 6 * ui_s ? y = ui_edy - h - 14 * ui_s; y = max(6 * ui_s, y);
  ui_press && (mouse_x < x || mouse_x >= x + w || mouse_y < y || mouse_y >= y + h) ? ui_ed = 0;
  ui_press = 0;
  ui_ed ? (
    ui_c(ui_cBg, 0.45); gfx_rect(0, 0, gfx_w, gfx_h);
    ui_float(x, y, w, h);
    gfx_setfont(2); ui_caps(#ui_edl); ui_c(ui_cMuted, 1);
    gfx_x = x + 10 * ui_s; gfx_y = y + 8 * ui_s; gfx_drawstr(#ui_txt);
    strcpy(#ui_txt, "ENTER"); gfx_measurestr(#ui_txt, ui_tw, ui_th); ui_c(ui_cMuted, 0.6);
    gfx_x = x + w - 10 * ui_s - ui_tw; gfx_y = y + 8 * ui_s; gfx_drawstr(#ui_txt);
    fx = x + 8 * ui_s; fy = y + 26 * ui_s; fw = w - 16 * ui_s; fh = 26 * ui_s;
    ui_c(ui_cAccent, 1); ui_rrect(fx - ui_s, fy - ui_s, fw + 2 * ui_s, fh + 2 * ui_s, 7 * ui_s);
    ui_c(ui_cBg, 1); ui_rrect(fx, fy, fw, fh, 6 * ui_s);
    gfx_setfont(1); gfx_measurestr(#ui_edt, ui_tw, ui_th);
    tx = fx + 8 * ui_s;
    ui_edsel && ui_tw > 0 ? ( ui_c(ui_cAccent, 0.35); gfx_rect(tx - 2 * ui_s, fy + (fh - ui_th) / 2 - ui_s, ui_tw + 4 * ui_s, ui_th + 2 * ui_s); );
    ui_c(ui_cText, 1); gfx_x = tx; gfx_y = fy + (fh - ui_th) / 2; gfx_drawstr(#ui_edt);
    // caret, blinking
    !ui_edsel && floor(time_precise() * 2) % 2 == 0 ? ( ui_c(ui_cAccent, 1); gfx_rect(tx + ui_tw + ui_s, fy + 6 * ui_s, max(1, ui_s), fh - 12 * ui_s); );
    strcpy(#ui_txt, ui_edfmt == 1 ? "dB" : ui_edfmt == 2 ? "%" : ui_edfmt == 3 ? "Hz" : ui_edfmt == 4 ? "ms" : "");
    gfx_measurestr(#ui_txt, ui_tw, ui_th); ui_c(ui_cMuted, 1);
    gfx_x = fx + fw - 8 * ui_s - ui_tw; gfx_y = fy + (fh - ui_th) / 2; gfx_drawstr(#ui_txt);
  );
);

// One "label   value" line of the About dialog.
function ui_arow(x, y, w, label, val) (
  gfx_setfont(3); ui_c(ui_cMuted, 1); gfx_x = x; gfx_y = y; gfx_drawstr(label);
  ui_c(ui_cText, 1); gfx_x = x + 70 * ui_s; gfx_y = y; gfx_drawstr(val);
);

// The About dialog: what reaper-mcp is, where to find it, this plugin's facts and how the controls are
// used (the gestures every knob, bar and handle shares). Closes on a click outside it or on its x. In a
// short window the description lines go first, then the plugin's facts; the gestures stay while they fit.
function ui_aboutdraw() local(w, h, x, y, lh, nd, rows, bx, cy, hitx, kb, av) (
  lh = 13 * ui_s;
  av = gfx_h - 16 * ui_s;
  kb = av >= 225 * ui_s + 2 * lh;   // the gesture block: a heading and five lines
  av -= kb * 91 * ui_s;
  nd = av - 186 * ui_s >= 3 * lh ? 3 : 0;   // the description is all three lines or none, never cut mid-sentence
  rows = nd > 0 ? 6 : max(2, min(6, floor((av - 108 * ui_s) / lh)));
  w = min(gfx_w - 16 * ui_s, 300 * ui_s);
  h = (12 + 22 + 6 + 4 + 28 + 10 + 16 + 10) * ui_s + nd * lh + rows * lh + kb * 91 * ui_s;
  x = (gfx_w - w) / 2; y = max(8 * ui_s, (gfx_h - h) / 2);
  bx = x + w - 26 * ui_s;
  hitx = mouse_x >= bx && mouse_x < bx + 20 * ui_s && mouse_y >= y + 8 * ui_s && mouse_y < y + 28 * ui_s;
  ui_press && (hitx || mouse_x < x || mouse_x >= x + w || mouse_y < y || mouse_y >= y + h) ? ui_about = 0;
  ui_press = 0;
  hitx != ui_cur ? ( gfx_setcursor(hitx ? 32649 : 32512); ui_cur = hitx; );
  ui_about ? (
    ui_c(ui_cBg, 0.7); gfx_rect(0, 0, gfx_w, gfx_h);
    ui_float(x, y, w, h);
    // close x
    ui_c(hitx ? ui_cText : ui_cMuted, 1); cy = y + 18 * ui_s;
    gfx_line(bx + 6 * ui_s, cy - 4 * ui_s, bx + 14 * ui_s, cy + 4 * ui_s, 1); gfx_line(bx + 6 * ui_s, cy + 4 * ui_s, bx + 14 * ui_s, cy - 4 * ui_s, 1);
    gfx_line(bx + 7 * ui_s, cy - 4 * ui_s, bx + 15 * ui_s, cy + 4 * ui_s, 1); gfx_line(bx + 7 * ui_s, cy + 4 * ui_s, bx + 15 * ui_s, cy - 4 * ui_s, 1);
    // wordmark
    x += 14 * ui_s; y += 12 * ui_s;
    gfx_setfont(4); ui_c(ui_cAccent, 1); gfx_x = x; gfx_y = y; gfx_drawstr("reaper-mcp");
    gfx_setfont(2); ui_c(ui_cMuted, 0.8); strcpy(#ui_txt, "ABOUT"); gfx_measurestr(#ui_txt, ui_tw, ui_th);
    gfx_x += 8 * ui_s; gfx_y = y + 5 * ui_s; gfx_drawstr(#ui_txt);
    y += 22 * ui_s + 6 * ui_s;
    gfx_setfont(3); ui_c(ui_cText, 0.85);
    nd > 0 ? ( gfx_x = x; gfx_y = y; gfx_drawstr("AI-made plugins for REAPER: ask Claude Code to make"); y += lh; );
    nd > 1 ? ( gfx_x = x; gfx_y = y; gfx_drawstr("or tweak one and it writes this file. The plugin then"); y += lh; );
    nd > 2 ? ( gfx_x = x; gfx_y = y; gfx_drawstr("works on its own, without reaper-mcp running."); y += lh; );
    y += 4 * ui_s;
    ui_c(ui_cMuted, 1); gfx_x = x; gfx_y = y; gfx_drawstr("Source and docs (type it into a browser):"); y += 14 * ui_s;
    ui_c(ui_cText, 1); gfx_x = x; gfx_y = y; gfx_drawstr("github.com/mthines/reaper-mcp"); y += 14 * ui_s + 10 * ui_s;
    ui_c(ui_cLine, 1); gfx_rect(x, y - 6 * ui_s, w - 28 * ui_s, max(1, ui_s));
    gfx_setfont(2); ui_c(ui_cMuted, 1); gfx_x = x; gfx_y = y; gfx_drawstr("THIS PLUGIN"); y += 16 * ui_s;
    ui_example ? sprintf(#ui_txt, "%s (example)", #ui_name) : strcpy(#ui_txt, #ui_name);
    ui_arow(x, y, w, "Name", #ui_txt); y += lh;
    rows > 1 ? ( sprintf(#ui_txt, "%d", ui_pver); ui_arow(x, y, w, "Version", #ui_txt); y += lh; );
    rows > 2 ? ( sprintf(#ui_txt, "mcp_ui %s", #ui_tkv); ui_arow(x, y, w, "Toolkit", #ui_txt); y += lh; );
    rows > 3 ? (
      sprintf(#ui_txt, "    %s  #%06x", ui_akind == 2 ? "custom" : ui_akind == 1 ? "named" : "auto", ui_cAccent);
      ui_arow(x, y, w, "Accent", #ui_txt);
      ui_c(ui_cAccent, 1); gfx_circle(x + 70 * ui_s + 5 * ui_s, y + 6.5 * ui_s, 4.5 * ui_s, 1, 1);
      y += lh;
    );
    rows > 4 ? ( sprintf(#ui_txt, "%d", ui_nctl); ui_arow(x, y, w, "Controls", #ui_txt); y += lh; );
    rows > 5 ? ( ui_arow(x, y, w, "Written", strlen(#ui_date) ? #ui_date : "-"); y += lh; );
    kb ? (
      y += 10 * ui_s;
      ui_c(ui_cLine, 1); gfx_rect(x, y - 6 * ui_s, w - 28 * ui_s, max(1, ui_s));
      gfx_setfont(2); ui_c(ui_cMuted, 1); gfx_x = x; gfx_y = y; gfx_drawstr("CONTROLS"); y += 16 * ui_s;
      ui_arow(x, y, w, "Drag", "change the value"); y += lh;
      ui_arow(x, y, w, "Shift-drag", "fine adjust (10x finer)"); y += lh;
      ui_arow(x, y, w, "Wheel", "step the value"); y += lh;
      ui_arow(x, y, w, "Dbl-click", "type an exact value"); y += lh;
      ui_arow(x, y, w, "Cmd-click", "reset to default (Ctrl, Alt too)"); y += lh;
    );
    gfx_setfont(1);
  );
);

// A line of help for a knob, shown as a tooltip after the mouse rests on it for half a second (a few lines, ~44
// characters wide, so keep it to a sentence or two). Call once, in @init: ui_help(slider_idx, "text"). The text sits in
// string slot 900 + idx (numbered slots 0..1023 are the plugin's).
function ui_help(idx, text) ( strcpy(900 + idx, text); );
function ui_tipdraw() local(n, i, ls, ml, w, h, x, y, lines, at, brk) (
  ui_tipn > 0 && ui_tipf == ui_tipn && time_precise() - ui_tipt > 0.5 && strlen(900 + ui_tipn) > 0 && !ui_modal && ui_active == 0 ? (
    gfx_setfont(3);
    n = strlen(900 + ui_tipn); at = 0; lines = 0; w = 0;
    // break the text into lines of at most 44 characters, at a space where it can
    while (at < n && lines < 4) (
      ml = min(44, n - at); brk = ml;
      at + ml < n ? ( i = ml; while (i > 20 && str_getchar(900 + ui_tipn, at + i) != 32) ( i -= 1; ); i > 20 ? brk = i; );
      strcpy_substr(#ui_tmp, 900 + ui_tipn, at, brk);
      gfx_measurestr(#ui_tmp, ui_tw, ui_th); w = max(w, ui_tw);
      lines += 1; at += brk; str_getchar(900 + ui_tipn, at) == 32 ? at += 1;
    );
    h = lines * (ui_th + 2 * ui_s) + 10 * ui_s; w += 14 * ui_s;
    x = max(4 * ui_s, min(gfx_w - w - 4 * ui_s, ui_tipx - w / 2)); y = max(4 * ui_s, ui_tipy - h - 6 * ui_s);
    ui_c(ui_cLine, 1); ui_rrect(x - ui_s, y - ui_s, w + 2 * ui_s, h + 2 * ui_s, 6 * ui_s);
    ui_c(ui_cPanel2, 1); ui_rrect(x, y, w, h, 6 * ui_s);
    ui_c(ui_cText, 1);
    at = 0; ls = 0;
    while (at < n && ls < lines) (
      ml = min(44, n - at); brk = ml;
      at + ml < n ? ( i = ml; while (i > 20 && str_getchar(900 + ui_tipn, at + i) != 32) ( i -= 1; ); i > 20 ? brk = i; );
      strcpy_substr(#ui_tmp, 900 + ui_tipn, at, brk);
      gfx_x = x + 7 * ui_s; gfx_y = y + 5 * ui_s + ls * (ui_th + 2 * ui_s); gfx_drawstr(#ui_tmp);
      ls += 1; at += brk; str_getchar(900 + ui_tipn, at) == 32 ? at += 1;
    );
    gfx_setfont(1);
  );
  ui_tipf == 0 ? ui_tipn = 0;
  ui_tipf = 0;
);

function ui_end() (
  ui_gany != ui_gcur ? ( gfx_setcursor(ui_gany == 2 ? 32645 : (ui_gany ? 32644 : 32512)); ui_gcur = ui_gany; );   // a band handle: resize cursor
  ui_gany = 0;
  ui_bar == 0 ? ui_footer(gfx_h - ui_pad - 6 * ui_s, ui_pad + 6 * ui_s);
  ui_tipdraw();
  ui_ed ? ui_popover() : ui_about ? ui_aboutdraw();
  mouse_wheel = 0;
);

// The next ui_row is `span` rows tall (a graph wants more height than a row of knobs). Count it in
// ui_begin's core_rows: a 2-row graph and one row of knobs is ui_begin(3, ...).
function ui_tall(span) ( ui_rspan = max(1, floor(span)); );

function ui_row(n) (
  ui_ci = 0; ui_n = max(1, n);
  ui_cw = (gfx_w - 2 * ui_pad) / ui_n;
  ui_rs = max(1, ui_rspan); ui_rspan = 1;
  ui_ry0 = ui_y; ui_y += ui_rowh * ui_rs;
);

function ui_cell() (
  ui_rx = ui_pad + ui_ci * ui_cw; ui_ry = ui_ry0; ui_rw = ui_cw; ui_rh = ui_rowh * max(1, ui_rs);
  ui_ci += 1;
  ui_hit = mouse_x >= ui_rx && mouse_x < ui_rx + ui_rw && mouse_y >= ui_ry && mouse_y < ui_ry + ui_rh
           && !(ui_core && ui_blocked) && !ui_modal;
  // every widget is one block centred in its cell: label, body (a knob's height), value.
  // The same for every cell of a row, so labels and values line up across widget types.
  ui_kr = max(4 * ui_s, min(64 * ui_s, min(ui_rw / 2 - 8 * ui_s, (ui_rowh - 2 * ui_lh - 22 * ui_s) / 2)));   // a tall cell keeps the knob size of a normal row
  ui_lby = ui_ry + (ui_rh - 2 * ui_lh - 12 * ui_s - 2 * ui_kr) / 2;
  ui_by = ui_lby + ui_lh + 6 * ui_s; ui_bh = 2 * ui_kr;
);

// label (top) and value line (bottom) of the current cell; #ui_txt holds the value
function ui_label(label, hot) (
  gfx_setfont(2); ui_caps(label);
  ui_c(hot ? ui_cText : ui_cMuted, 1); ui_ctext(ui_rx, ui_lby, ui_rw, ui_lh);
  gfx_setfont(1);
);
function ui_value(col) ( ui_c(col, 1); ui_ctext(ui_rx, ui_by + ui_bh + 6 * ui_s, ui_rw, ui_lh); );

// fmt: 0 number, 1 dB, 2 percent of 0..1, 3 Hz/kHz, 4 ms, 5 integer
function ui_fmtv(fmt, v) (
  fmt == 1 ? sprintf(#ui_txt, "%.1f dB", v) :
  fmt == 2 ? sprintf(#ui_txt, "%.0f%%", v * 100) :
  fmt == 3 ? (v >= 1000 ? sprintf(#ui_txt, "%.1f kHz", v / 1000) : sprintf(#ui_txt, "%.0f Hz", v)) :
  fmt == 4 ? sprintf(#ui_txt, "%.0f ms", v) :
  fmt == 5 ? sprintf(#ui_txt, "%d", v) :
  sprintf(#ui_txt, "%.2f", v);
);

// Drag (200 px = the full range, Shift = 10x finer), wheel, Cmd/Ctrl/Alt-click = default
// (mouse_cap 4 = Cmd on macOS / Ctrl elsewhere, 32 = Ctrl on macOS, 16 = Alt), double-click =
// type a value (a box opens next to the knob at x, y).
function ui_reset(idx) ( ui_set(idx, ui_def[idx]); slider_automate(2 ^ (idx - 1), 1); ui_lci = 0; );
function ui_ctl(idx, fmt, label, x, y) local(lo, hi, st, t, fine) (
  lo = ui_min[idx]; hi = ui_max[idx]; st = ui_stp[idx];
  ui_hit && ui_press ? (
    t = time_precise();
    (mouse_cap & 52) ? ui_reset(idx) :
    (ui_lci == idx && t - ui_lct < 0.45) ? ui_edopen(idx, fmt, label, x, y) :
    ( ui_active = idx; ui_ly = mouse_y; ui_acc = slider(idx); ui_lci = idx; ui_lct = t; );
  );
  ui_active == idx && ui_down ? (
    fine = mouse_cap & 8;
    ui_acc += (ui_ly - mouse_y) / (200 * ui_s * (fine ? 10 : 1)) * (hi - lo);
    ui_acc = min(hi, max(lo, ui_acc));
    ui_ly = mouse_y;
    ui_set(idx, ui_q(idx, ui_acc));
  );
  ui_hit && mouse_wheel != 0 ? (
    ui_set(idx, ui_q(idx, slider(idx) + sign(mouse_wheel) * (st > 0 ? st : (hi - lo) / ((mouse_cap & 8) ? 200 : 40))));
  );
  ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; );
);

// Mix and Output in the top right of every plugin that has them: call ui_header(mix_idx, out_idx) in @gfx
// before ui_begin (0 = this plugin has no such slider). Two slim horizontal bars with the usual gestures; the
// label shows the value while you hover or drag. Do not draw those two sliders as widgets as well.
function ui_header(m, o) ( ui_hm = max(0, floor(m)); ui_ho = max(0, floor(o)); );

// A pill exactly h pixels tall: the end caps are circles of diameter h, so they never stick out past the bar.
function ui_pill(x, y, w, h) local(r) (
  r = h / 2;
  w <= h ? gfx_rect(x, y, w, h) : (
    gfx_rect(x + r, y, w - h, h);
    gfx_circle(x + r - 0.5, y + r - 0.5, r - 0.5, 1, 1);
    gfx_circle(x + w - r - 0.5, y + r - 0.5, r - 0.5, 1, 1);
  );
);

// One slim horizontal bar (like the level bar in Vital's header) whose right edge is xr; returns the x of the
// next one to its left. Drag left or right (Shift = fine), wheel, double-click to type, modifier-click resets.
// The header band is centred on y = 15 px, the same line the plugin name sits on.
function ui_hbar(idx, label, fmt, xr) local(bw, bh, bx, cy, by, lo, hi, st, t, t0, hot, tt, x0, x1) (
  bw = 58 * ui_s; bh = 6 * ui_s; bx = xr - bw; cy = 15 * ui_s;
  by = cy - 0.5 * ui_s;   // the caps' ink sits half a pixel above the line box's middle: the bar follows the ink
  lo = ui_min[idx]; hi = ui_max[idx]; st = ui_stp[idx];
  ui_hit = !(ui_core && ui_blocked) && !ui_modal && mouse_x >= xr - 112 * ui_s && mouse_x < xr && mouse_y >= cy - 10 * ui_s && mouse_y < cy + 10 * ui_s;
  ui_hit && ui_press ? (
    tt = time_precise();
    (mouse_cap & 52) ? ui_reset(idx) :
    (ui_lci == idx && tt - ui_lct < 0.45) ? ui_edopen(idx, fmt, label, bx, cy + 12 * ui_s) :
    ( ui_active = idx; ui_lx = mouse_x; ui_acc = slider(idx); ui_lci = idx; ui_lct = tt; );
  );
  ui_active == idx && ui_down ? (
    ui_acc = min(hi, max(lo, ui_acc + (mouse_x - ui_lx) / (bw * ((mouse_cap & 8) ? 10 : 1)) * (hi - lo)));
    ui_lx = mouse_x;
    ui_set(idx, ui_q(idx, ui_acc));
  );
  ui_hit && mouse_wheel != 0 ? (
    ui_set(idx, ui_q(idx, slider(idx) + sign(mouse_wheel) * (st > 0 ? st : (hi - lo) / ((mouse_cap & 8) ? 200 : 40))));
  );
  ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; );
  t = min(1, max(0, (slider(idx) - lo) / (hi - lo)));
  t0 = (lo < 0 && hi > 0) ? -lo / (hi - lo) : 0;
  hot = ui_active == idx || ui_hit;
  ui_c(hot ? ui_cTrackHot : ui_cTrack, 1); ui_pill(bx, by - bh / 2, bw, bh);
  abs(t - t0) > 0.002 ? (
    x0 = bx + bw * min(t, t0); x1 = bx + bw * max(t, t0);
    ui_c(ui_active == idx ? ui_cAccentAct : (hot ? ui_cAccentHi : ui_cAccent), 1);
    ui_pill(x0, by - bh / 2, max(1, x1 - x0), bh);
  );
  ui_c(hot ? ui_cText : ui_cMuted, 1); gfx_rect(bx + bw * t - ui_s / 2, by - bh, max(1, ui_s), bh * 2);
  gfx_setfont(2);
  hot ? ui_fmtv(fmt, slider(idx)) : ui_caps(label);
  gfx_measurestr(#ui_txt, ui_tw, ui_th);
  ui_c(ui_active == idx ? ui_cAccent : (hot ? ui_cText : ui_cMuted), 1);
  gfx_x = bx - 6 * ui_s - ui_tw; gfx_y = cy - ui_th / 2; gfx_drawstr(#ui_txt);
  gfx_setfont(1);
  xr - 118 * ui_s;
);

// Returns 1 when the frame needs drawing. Nothing changed = nothing drawn, the old frame stays.
// The core rows keep one fixed layout; the Advanced drawer slides over them and never resizes them.
function ui_begin(core_rows, adv_rows) local(h, i, now, e, top) (
  ui_s = max(gfx_ext_retina, 1);
  ui_pad = 10 * ui_s; ui_lh = 14 * ui_s;
  ui_bar = adv_rows > 0 ? 28 * ui_s : 0;
  ui_down = mouse_cap & 1;
  ui_press = ui_down && !ui_was_down;
  ui_rel = !ui_down && ui_was_down;
  ui_rpress = (mouse_cap & 2) && !ui_was_r;
  ui_was_down = ui_down; ui_was_r = mouse_cap & 2;
  ui_keys();
  ui_modal = ui_ed > 0 || ui_about;   // a value box or the About dialog takes every click

  // the drawer glides open/closed in about 0.15 s
  now = time_precise();
  ui_p < 0 ? ui_p = ui_adv_open;
  ui_p = ui_adv_open ? min(1, ui_p + (now - ui_lt) / 0.15) : max(0, ui_p - (now - ui_lt) / 0.15);
  ui_lt = now;

  h = gfx_w * 7 + gfx_h * 13 + mouse_x * 3 + mouse_y * 5 + mouse_cap * 11 + ui_adv_open * 17
      + mouse_wheel * 23 + floor(now * 2) * 19 + ui_p * 29 + ui_ed * 31 + ui_edv * 37 + ui_about * 41
      + ui_fh * 43 + ui_fh2 * 47 + ui_fh3 * 53 + ui_fh4 * 59 + ui_fsel * 61 + ui_fcmp * 67
      + (ui_tipn > 0 ? floor(now * 8) * 83 : 0) + floor(ui_sqph / 6) * 71 + ui_sqbl * 73 + ui_sqbf * 79;
  i = 1; loop(64, h += slider(i) * (i + 0.37); i += 1;);
  ui_dirty = ui_animated == 1 || h != ui_hash || (ui_p > 0 && ui_p < 1);
  ui_hash = h;

  ui_dirty ? (
    ui_bg();
    gfx_setfont(1, "Arial", 12 * ui_s);
    gfx_setfont(2, "Arial", 9.5 * ui_s, 'b');
    gfx_setfont(3, "Arial", 10.5 * ui_s);
    gfx_setfont(4, "Arial", 15 * ui_s, 'b');
    gfx_setfont(5, "Arial", 8.5 * ui_s, 'b');
    gfx_setfont(1);
    ui_ytop = 25 * ui_s;   // name and bars are centred on y = 15; the first row's own padding makes the gap below match the 11 px above
    ui_nlim = gfx_w - ui_pad - ((ui_hm > 0) + (ui_ho > 0)) * 118 * ui_s;
    ui_namedraw();
    ui_core = 1;
    ui_blocked = adv_rows > 0 && (ui_adv_open || ui_p > 0);
    (ui_hm || ui_ho) && gfx_w >= 280 * ui_s ? (
      i = gfx_w - ui_pad;
      ui_ho ? i = ui_hbar(ui_ho, "Output", 1, i);
      ui_hm ? i = ui_hbar(ui_hm, "Mix", 2, i);
    );
    // core: the window minus the drawer's closed bar (or the footer line when there is no drawer)
    ui_rowh = (gfx_h - ui_ytop - (adv_rows > 0 ? ui_bar + 4 * ui_s : ui_pad + (ui_credit ? 6 * ui_s : 0))) / max(1, core_rows);
    ui_y = ui_ytop; ui_mi = 0;
    // the drawer: rows of a comfortable fixed height, leaving a strip of the core view above it
    ui_arowh = adv_rows > 0 ? min(100 * ui_s, max(60 * ui_s, (gfx_h - 40 * ui_s - ui_bar - ui_pad) / adv_rows)) : 0;
    top = max(8 * ui_s, gfx_h - ui_bar - adv_rows * ui_arowh - ui_pad);
    e = ui_p * ui_p * (3 - 2 * ui_p);
    ui_sy = gfx_h - ui_bar - (gfx_h - ui_bar - top) * e;
    ui_e = e;
  );
  ui_dirty;
);

// ---- widgets ------------------------------------------------------------------------------

// A ring knob: dim track, one accent stroke for the value (from 0 when the range crosses it),
// a face with a dot pointing at the value. 7:30 to 4:30 o'clock.
function ui_knob(idx, label, fmt) local(lo, hi, t, t0, r, th, cx, cy, a0, a1, av, aa, fr, hot, dr) (
  ui_cell(); ui_ctl(idx, fmt, label, ui_rx + ui_rw / 2, ui_by + ui_bh / 2);
  lo = ui_min[idx]; hi = ui_max[idx];
  t = min(1, max(0, (slider(idx) - lo) / (hi - lo)));
  t0 = (lo < 0 && hi > 0) ? -lo / (hi - lo) : 0;
  hot = ui_active == idx || ui_hit;
  ui_hit && ui_active == 0 && !ui_modal && strlen(900 + idx) > 0 ? (
    ui_tipn != idx ? ( ui_tipn = idx; ui_tipt = time_precise(); );
    ui_tipf = idx; ui_tipx = ui_rx + ui_rw / 2; ui_tipy = ui_by;
  );
  r = ui_kr;
  cx = ui_rx + ui_rw / 2; cy = ui_by + ui_bh / 2;
  th = max(3 * ui_s, r * 0.14);
  a0 = -2.35; a1 = 2.35;
  av = a0 + (a1 - a0) * t; aa = a0 + (a1 - a0) * t0;
  ui_c(hot ? ui_cTrackHot : ui_cTrack, 1); ui_ring(cx, cy, r - th, r, a0, a1);
  abs(t - t0) > 0.002 ? (
    ui_c(ui_active == idx ? ui_cAccentAct : (hot ? ui_cAccentHi : ui_cAccent), 1);
    ui_ring(cx, cy, r - th, r, min(aa, av), max(aa, av));
  );
  fr = r - th - max(3 * ui_s, r * 0.12);
  fr > 4 * ui_s ? (
    ui_cm(ui_cPanel2, ui_cLine, hot ? 0.9 : 0.4); gfx_circle(cx, cy, fr, 1, 1);
    ui_cm(ui_cLine, ui_cMuted, hot ? 0.3 : 0.15); gfx_circle(cx, cy, fr, 0, 1);
    dr = max(1.5 * ui_s, fr * 0.12);
    ui_c(hot ? ui_cAccent : ui_cText, 1);
    gfx_circle(cx + sin(av) * (fr - dr * 2.2), cy - cos(av) * (fr - dr * 2.2), dr, 1, 1);
  );
  ui_label(label, hot);
  ui_fmtv(fmt, slider(idx)); ui_value(ui_active == idx ? ui_cAccent : ui_cText);
);

function ui_toggle(idx, label) local(on, w, h, x, y, hot) (
  ui_cell();
  ui_hit && ui_press ? ( (mouse_cap & 52) ? ui_reset(idx) : ( ui_set(idx, slider(idx) ? 0 : 1); slider_automate(2 ^ (idx - 1), 1); ); );
  on = slider(idx) > 0.5; hot = ui_hit;
  w = min(ui_rw - 12 * ui_s, 42 * ui_s); h = 22 * ui_s;
  x = ui_rx + (ui_rw - w) / 2; y = ui_by + (ui_bh - h) / 2;
  on ? ui_c(hot ? ui_cAccentHi : ui_cAccent, 1) : ui_cm(ui_cLine, ui_cMuted, hot ? 0.2 : 0.06);
  ui_rrect(x, y, w, h, h / 2);
  ui_c(on ? ui_cBg : ui_cText, on ? 1 : 0.75);
  gfx_circle(on ? x + w - h / 2 - 1 : x + h / 2, y + h / 2 - 0.5, h / 2 - 3 * ui_s, 1, 1);
  ui_label(label, hot);
  strcpy(#ui_txt, on ? "On" : "Off"); ui_value(on ? ui_cAccent : ui_cMuted);
);

// Click = next option, right-click = previous, Cmd/Ctrl/Alt-click = default. Option names come from the slider's {A,B,C} list.
function ui_choice(idx, label) local(n, k, w, h, x, y, hot, m) (
  ui_cell();
  n = ui_max[idx] - ui_min[idx] + 1; k = slider(idx) - ui_min[idx];
  ui_hit && ui_press ? ( (mouse_cap & 52) ? ui_reset(idx) : ( ui_set(idx, ui_min[idx] + (k + 1) % n); slider_automate(2 ^ (idx - 1), 1); ); );
  ui_hit && ui_rpress ? ( ui_set(idx, ui_min[idx] + (k + n - 1) % n); slider_automate(2 ^ (idx - 1), 1); );
  k = slider(idx) - ui_min[idx]; hot = ui_hit;
  w = min(ui_rw - 12 * ui_s, 104 * ui_s); h = 24 * ui_s;
  x = ui_rx + (ui_rw - w) / 2; y = ui_by + (ui_bh - h) / 2;
  ui_cm(ui_cPanel2, ui_cLine, hot ? 0.9 : 0.35); ui_rrect(x, y, w, h, 6 * ui_s);
  ui_c(hot ? ui_cAccent : ui_cLine, 1); gfx_roundrect(x, y, w - 1, h - 1, 6 * ui_s, 1);
  ui_c(ui_cText, 1); strcpy(#ui_txt, idx * 8 + k); ui_ctext(x, y, w, h);
  // small arrows at both ends: it steps
  m = y + h / 2; ui_c(hot ? ui_cAccent : ui_cMuted, 1);
  gfx_triangle(x + 7 * ui_s, m, x + 11 * ui_s, m - 3.5 * ui_s, x + 11 * ui_s, m + 3.5 * ui_s);
  gfx_triangle(x + w - 7 * ui_s, m, x + w - 11 * ui_s, m - 3.5 * ui_s, x + w - 11 * ui_s, m + 3.5 * ui_s);
  ui_label(label, hot);
  sprintf(#ui_txt, "%d / %d", k + 1, n); ui_value(ui_cMuted);
);

// level: the peak (linear) the audio thread kept with max(); reset it to 0 after the call.
// Holds a fast attack and a 30 dB/s release, drawn from -60 to +6 dB.
function ui_meter(level, label) local(db, p, now, base, w, h, x, y, t, fh, z) (
  ui_cell();
  now = time_precise(); base = ui_mtr + ui_mi * 2; ui_mi += 1;
  db = 20 * log10(max(level, 0.000001));
  p = ui_mtr[base] - 30 * (now - ui_mtr[base + 1]);
  ui_mtr[base] = max(max(db, p), -60); ui_mtr[base + 1] = now;
  w = 8 * ui_s; h = ui_bh;
  x = ui_rx + (ui_rw - w) / 2; y = ui_by;
  ui_cm(ui_cPanel2, ui_cLine, 0.5); ui_rrect(x, y, w, h, w / 2);
  t = (ui_mtr[base] + 60) / 66; fh = h * t;
  fh > 1 ? (
    ui_c(ui_mtr[base] > -0.5 ? ui_cBad : (ui_mtr[base] > -6 ? ui_cWarn : ui_cLive), 1);
    ui_rrect(x, y + h - fh, w, fh, min(w / 2, fh / 2));
  );
  // ticks at 0 and -12 dB
  z = y + h * 6 / 66; ui_c(ui_cMuted, 0.8); gfx_rect(x - 4 * ui_s, z, 3 * ui_s, max(1, ui_s));
  gfx_rect(x + w + ui_s, z, 3 * ui_s, max(1, ui_s));
  z = y + h * 18 / 66; ui_c(ui_cMuted, 0.4); gfx_rect(x - 3 * ui_s, z, 2 * ui_s, max(1, ui_s));
  gfx_rect(x + w + ui_s, z, 2 * ui_s, max(1, ui_s));
  ui_label(label, 0);
  ui_mtr[base] > -59.5 ? sprintf(#ui_txt, "%.1f", ui_mtr[base]) : strcpy(#ui_txt, "-inf");
  ui_value(ui_mtr[base] > -0.5 ? ui_cBad : ui_cMuted);
);

// The Advanced drawer. Closed: a bar along the bottom. Open: a panel that slides up over the
// core view (which keeps its size and dims behind it). Returns 1 while visible: draw the
// Advanced rows then. Close it with the bar or a click above it (or Esc, only when the FX window
// sends all keyboard input to the plug-in; see the header).
function ui_section(label) local(y, hit, k) (
  ui_bar == 0 ? ui_bar = 28 * ui_s;
  y = ui_sy;
  ui_e > 0 ? (
    ui_c(ui_cBg, 0.62 * ui_e); gfx_rect(0, 0, gfx_w, y);
    ui_adv_open && ui_press && mouse_y < y && !ui_modal ? ( ui_adv_open = 0; ui_press = 0; );
    // soft shadow above the panel
    k = 0; loop(6, ui_c(0, 0.05 * ui_e * (6 - k)); gfx_rect(0, y - k * ui_s - ui_s, gfx_w, ui_s); k += 1;);
  );
  ui_c(ui_cPanel, 1); ui_rrect(0, y, gfx_w, gfx_h - y + 14 * ui_s, 12 * ui_s);
  ui_c(ui_cLine, 1); gfx_roundrect(0, y, gfx_w - 1, gfx_h - y + 14 * ui_s, 12 * ui_s, 1);
  hit = mouse_y >= y && mouse_y < y + ui_bar && mouse_x >= 0 && mouse_x < gfx_w && !ui_modal;
  ui_footer(y, ui_bar) ? hit = 0;
  hit && ui_press ? ( ui_adv_open = !ui_adv_open; ui_press = 0; );
  // grab handle, title, chevron
  ui_cm(ui_cLine, ui_cMuted, hit ? 0.5 : 0.25); ui_rrect(gfx_w / 2 - 14 * ui_s, y + 5 * ui_s, 28 * ui_s, 3 * ui_s, 1.5 * ui_s);
  gfx_setfont(2); ui_caps(label);
  ui_c(hit || ui_adv_open ? ui_cAccent : ui_cMuted, 1);
  gfx_measurestr(#ui_txt, ui_tw, ui_th);
  gfx_x = ui_pad + 2 * ui_s; gfx_y = y + (ui_bar - ui_th) / 2 + 2 * ui_s; gfx_drawstr(#ui_txt);
  gfx_setfont(1);
  ui_c(hit ? ui_cAccent : ui_cMuted, 1); ui_chev(gfx_w - ui_pad - 6 * ui_s, y + ui_bar / 2 + ui_s, !ui_adv_open);
  ui_core = 0;
  ui_y = y + ui_bar; ui_rowh = ui_arowh;
  ui_e > 0;
);

// ---- graphs: feeds (call from @block, at most once per FFT or MIDI event) -------------------------
// Each feed keeps a running hash of its values rounded to a visible step, so with ui_boot(2) the UI
// redraws only when something on screen would look different.

// One trace point (dB). Internal: use ui_gset or ui_gfeed.
function ui_gput(i, v) local(q0, q1) (
  q0 = floor((ui_gt[i] + 120) / 1.5); q1 = floor((v + 120) / 1.5);
  ui_fh += (q1 - q0) * (1 + i % 7);
  ui_gt[i] = v;
);

// Trace point i (0..ui_gn-1, log-spaced from 20 Hz to 20 kHz) in dB: any curve the plugin computes.
function ui_gset(i, db) ( ui_gput(min(ui_gn - 1, max(0, floor(i))), min(12, max(-120, db))); );

// Spectrum trace from n linear FFT magnitudes in buf (bin i = i * srate / 2 / n Hz; scale them so a
// full-scale sine reads about 1). Fast attack, slow release, so a held tone stays and silence fades.
function ui_gfeed(buf, n) local(p, b0, b1, m, j, db, old, nyq) (
  nyq = srate / 2; p = 0;
  loop(ui_gn,
    b0 = min(n - 1, floor(20 * exp(p / ui_gn * 6.907755) / nyq * n));
    b1 = min(n - 1, max(b0, floor(20 * exp((p + 1) / ui_gn * 6.907755) / nyq * n) - 1));
    m = 0; j = b0;
    loop(b1 - b0 + 1, m = max(m, buf[j]); j += 1;);
    // a point narrower than one bin: lean between the two bins around its centre (no stairs at the low end)
    b1 == b0 && b0 < n - 1 ? (
      j = 20 * exp((p + 0.5) / ui_gn * 6.907755) / nyq * n - b0;
      m = buf[b0] * (1 - min(1, max(0, j))) + buf[b0 + 1] * min(1, max(0, j));
    );
    db = 20 * log10(max(m, 0.000001));
    old = ui_gt[p];
    ui_gput(p, db > old ? old + (db - old) * 0.7 : old + (db - old) * 0.12);
    p += 1;
  );
);

// The same for the input, drawn as a second, lighter line while ui_gshow(1): the before/after view. Feed it
// only while it is shown (a second FFT costs).
function ui_gfeed2(buf, n) ( ui_gt = ui_fi; ui_gfeed(buf, n); ui_gt = ui_fg; );
// Show (1) or hide (0) the input trace; call it in @gfx before ui_freqgraph with the compare toggle's slider.
function ui_gshow(on) ( ui_fcmp = on > 0.5; );

// Gain reduction of band k (0..7) in dB, as a positive number (6 = 6 dB of reduction).
function ui_gr(k, db) local(q0, q1) (
  k = min(7, max(0, floor(k))); db = min(48, max(0, db));
  q0 = floor(ui_grm[k] / 0.5); q1 = floor(db / 0.5);
  ui_fh2 += (q1 - q0) * (1 + k);
  ui_grm[k] = db;
);

// The live input level in dB for the transfer curve's dot (-90 or less hides the dot).
function ui_glevel(db) (
  ui_glv = min(6, max(-90, db));
  ui_fh4 = floor((ui_glv + 90) / 1);
);

// ---- frequency graph ----------------------------------------------------------------------------

// x of a frequency and the frequency of an x on the current graph (log axis, 20 Hz to 20 kHz).
function ui_fxof(f) ( ui_gx + ui_gw * log(max(f, 20) / 20) / 6.907755; );
function ui_fof(x) ( 20 * exp(min(1, max(0, (x - ui_gx) / ui_gw)) * 6.907755); );
function ui_gyof(db) ( ui_gy + ui_gh * min(1, max(0, 0 - db / 72)); );

// A log frequency graph filling the current cell: gridlines and labels, the fed trace (ui_gfeed /
// ui_gset) and the selected band. A click between handles selects that band (ui_fsel, 0 = lowest).
// Draw its draggable band edges right after it with ui_fhandle, one per slider in Hz, in ascending order.
function ui_freqgraph(label) local(px, py, pw, ph, i, f, m, mult, x, y, y0, x0, hot, near, ex, sel, lo, hi, a, b, n, gb) (
  ui_cell();
  ui_gpn = ui_gnb; ui_gk = 0;
  px = ui_rx + 2 * ui_s; py = ui_ry + 4 * ui_s; pw = ui_rw - 4 * ui_s; ph = ui_rh - 8 * ui_s;
  ui_gx = px + 8 * ui_s; ui_gw = pw - 16 * ui_s; ui_gy = py + 6 * ui_s; ui_gh = ph - 22 * ui_s;
  ui_gh > 20 * ui_s && ui_gw > 40 * ui_s ? (
    ui_cm(ui_cPanel2, ui_cLine, 0.3); ui_rrect(px, py, pw, ph, 8 * ui_s);
    ui_c(ui_cLine, 1); gfx_roundrect(px, py, pw - 1, ph - 1, 8 * ui_s, 1);
    hot = mouse_x >= ui_gx && mouse_x < ui_gx + ui_gw && mouse_y >= ui_gy && mouse_y < ui_gy + ui_gh
          && !(ui_core && ui_blocked) && !ui_modal;
    gb = ui_gy + ui_gh;

    // the selected band
    n = min(ui_gpn, 15);
    sel = min(ui_fsel, n);
    lo = sel == 0 ? 20 : slider(ui_ge[sel - 1]);
    hi = sel == n ? 20000 : slider(ui_ge[sel]);
    a = ui_fxof(lo); b = ui_fxof(hi);
    ui_c(ui_cAccent, 0.09); gfx_rect(a, ui_gy, max(1, b - a), ui_gh);
    ui_c(ui_cAccent, 0.55); gfx_rect(a, ui_gy, max(1, b - a), max(1, ui_s));

    // horizontal dB lines every 12 dB
    i = 1; loop(5, y = ui_gyof(0 - 12 * i); ui_c(ui_cMuted, 0.1); gfx_rect(ui_gx, y, ui_gw, max(1, ui_s)); i += 1;);
    // vertical frequency lines and labels: 50 100 200 500 1k 2k 5k 10k
    gfx_setfont(2);
    i = 0;
    loop(8,
      m = (i - 1) % 3; mult = m == 0 ? 1 : (m == 1 ? 2 : 5);
      f = i == 0 ? 50 : 100 * 10 ^ floor((i - 1) / 3) * mult;
      x = ui_fxof(f);
      ui_c(ui_cMuted, (f == 100 || f == 1000 || f == 10000) ? 0.2 : 0.09); gfx_rect(x, ui_gy, max(1, ui_s), ui_gh);
      (f == 100 || f == 1000 || f == 10000 || ui_gw > 300 * ui_s) ? (
        f >= 1000 ? sprintf(#ui_txt, "%dk", f / 1000) : sprintf(#ui_txt, "%d", f);
        gfx_measurestr(#ui_txt, ui_tw, ui_th);
        ui_c(ui_cMuted, 0.75); gfx_x = x - ui_tw / 2; gfx_y = gb + 4 * ui_s; gfx_drawstr(#ui_txt);
      );
      i += 1;
    );
    ui_caps(label); gfx_measurestr(#ui_txt, ui_tw, ui_th);
    ui_c(ui_cMuted, 0.5); gfx_x = ui_gx + ui_gw - ui_tw - 2 * ui_s; gfx_y = ui_gy + ui_gh - ui_th - 3 * ui_s; gfx_drawstr(#ui_txt);
    gfx_setfont(1);

    // the trace: a filled area under a line
    i = 1; x0 = ui_gx; y0 = ui_gyof(ui_fg[0]);
    loop(ui_gn - 1,
      x = ui_gx + ui_gw * i / (ui_gn - 1); y = ui_gyof(ui_fg[i]);
      (y0 < gb - 0.5 || y < gb - 0.5) ? (
        ui_c(ui_cAccent, 0.16);
        a = floor(x0); b = floor(x); y = (y0 + y) / 2;
        gfx_rect(a, y, max(1, b - a), gb - y);
        y = ui_gyof(ui_fg[i]);
        ui_c(ui_cAccent, 0.85); gfx_line(x0, y0, x, y, 1);
      );
      x0 = x; y0 = y; i += 1;
    );

    // the input trace over it, with a legend (before/after)
    ui_fcmp ? (
      i = 1; x0 = ui_gx; y0 = ui_gyof(ui_fi[0]);
      loop(ui_gn - 1,
        x = ui_gx + ui_gw * i / (ui_gn - 1); y = ui_gyof(ui_fi[i]);
        (y0 < gb - 0.5 || y < gb - 0.5) ? ( ui_c(ui_cText, 0.6); gfx_line(x0, y0, x, y, 1); );
        x0 = x; y0 = y; i += 1;
      );
      gfx_setfont(2);
      ui_caps("Output"); gfx_measurestr(#ui_txt, ui_tw, ui_th); a = ui_tw;
      ui_c(ui_cAccent, 1); gfx_x = ui_gx + ui_gw - a - 4 * ui_s; gfx_y = ui_gy + 34 * ui_s; gfx_drawstr(#ui_txt);
      ui_caps("Input"); gfx_measurestr(#ui_txt, ui_tw, ui_th);
      ui_c(ui_cText, 0.7); gfx_x = ui_gx + ui_gw - a - ui_tw - 16 * ui_s; gfx_y = ui_gy + 34 * ui_s; gfx_drawstr(#ui_txt);
      gfx_setfont(1);
    );

    // a press between handles picks that band
    near = 0; i = 0;
    loop(n, ex = ui_fxof(slider(ui_ge[i])); abs(mouse_x - ex) < 9 * ui_s ? near = 1; i += 1;);
    hot && ui_press && !near ? (
      f = ui_fof(mouse_x); sel = 0; i = 0;
      loop(n, slider(ui_ge[i]) < f ? sel += 1; i += 1;);
      ui_fsel = sel;
    );
  );
  hot;
);

// The grip of band edge k at f: a pill with the frequency, set as ui_pbx / ui_pby / ui_ppw (and the
// text in #ui_txt, font 2 measured).
function ui_fpill(f, k) (
  gfx_setfont(2); ui_fmtv(3, f); gfx_measurestr(#ui_txt, ui_tw, ui_th);
  ui_ppw = ui_tw + 12 * ui_s;
  ui_pbx = min(ui_gx + ui_gw - ui_ppw, max(ui_gx, ui_fxof(f) - ui_ppw / 2));
  ui_pby = ui_gy + 3 * ui_s + (k % 2) * 17 * ui_s;
);

// One draggable band edge, bound to slider idx (Hz). Drag = move it (kept between its neighbours),
// wheel = nudge, double-click = type a value, Cmd/Ctrl/Alt-click = reset. Call right after ui_freqgraph.
function ui_fhandle(idx, label) local(k, f, x, hit, t, lo, hi, nf, hot, drag) (
  k = ui_gk; ui_ge[k] = idx; ui_gk += 1; ui_gnb = ui_gk;
  ui_gk > ui_gpn ? ui_hash = -1;   // the graph learns its edges one frame late: draw once more
  f = slider(idx); x = ui_fxof(f);
  ui_fpill(f, k);
  hit = !(ui_core && ui_blocked) && !ui_modal && (
    (abs(mouse_x - x) < 9 * ui_s && mouse_y >= ui_gy && mouse_y < ui_gy + ui_gh) ||
    (mouse_x >= ui_pbx && mouse_x < ui_pbx + ui_ppw && mouse_y >= ui_pby && mouse_y < ui_pby + 14 * ui_s));
  hit && ui_press ? (
    t = time_precise();
    (mouse_cap & 52) ? ui_reset(idx) :
    (ui_lci == idx && t - ui_lct < 0.45) ? ui_edopen(idx, 3, label, x, ui_gy + ui_gh / 2) :
    ( ui_active = idx; ui_gdx = mouse_x - x; ui_lci = idx; ui_lct = t; ui_press = 0; );
  );
  ui_active == idx && ui_down ? (
    lo = k > 0 ? slider(ui_ge[k - 1]) * 1.1 : ui_min[idx];
    hi = k + 1 < ui_gpn ? slider(ui_ge[k + 1]) / 1.1 : ui_max[idx];
    nf = ui_fof(mouse_x - ui_gdx);
    ui_set(idx, ui_q(idx, min(hi, max(lo, nf))));
  );
  hit && mouse_wheel != 0 ? ui_set(idx, ui_q(idx, slider(idx) * (mouse_wheel > 0 ? 1.04 : 0.96)));
  ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; );
  drag = ui_active == idx; hot = hit || drag;
  hot ? ui_gany = 1;
  // the line down to the axis, then the pill on top of it
  f = slider(idx); x = ui_fxof(f); ui_fpill(f, k);
  ui_c(drag ? ui_cAccentAct : (hot ? ui_cAccentHi : ui_cAccent), hot ? 0.9 : 0.6);
  gfx_rect(x, ui_pby + 14 * ui_s, max(1, ui_s), ui_gy + ui_gh - ui_pby - 14 * ui_s);
  ui_cm(ui_cPanel2, ui_cLine, hot ? 0.3 : 0.6); ui_rrect(ui_pbx, ui_pby, ui_ppw, 14 * ui_s, 7 * ui_s);
  ui_c(hot ? ui_cAccent : ui_cLine, 1); gfx_roundrect(ui_pbx, ui_pby, ui_ppw - 1, 14 * ui_s - 1, 7 * ui_s, 1);
  ui_c(drag ? ui_cAccent : ui_cText, 1);
  gfx_x = ui_pbx + 6 * ui_s; gfx_y = ui_pby + (14 * ui_s - ui_th) / 2; gfx_drawstr(#ui_txt);
  gfx_setfont(1);
);

// ---- per-band thresholds ---------------------------------------------------------------------------

// A threshold line across each band of the frequency graph, one slider per band (thr_first, thr_first + 1, ...,
// in dB, -60..0 on the graph's dB axis) and one ratio slider per band (ratio_first, ...). Hover a band
// and drag up or down to move its threshold, wheel to change its ratio, a click selects it (ui_fsel);
// Shift-drag moves the band's gain instead (gain_first, ...), double-click types a threshold, Cmd/Ctrl/Alt-click
// resets it (with Shift, the gain). n is the number of bands (the handles + 1).
// Call it after ui_freqgraph and its ui_fhandles.
function ui_fthresh(thr_first, ratio_first, gain_first, n) local(k, a, b, x, y, idx, rdx, gdx, lo, hi, hot, drag, gdrag, near, i, sel, t, sh) (
  n = max(1, min(8, floor(n)));
  k = 0;
  loop(n,
    idx = thr_first + k; rdx = ratio_first + k; gdx = gain_first + k;
    lo = k == 0 ? 20 : slider(ui_ge[k - 1]); hi = k == n - 1 ? 20000 : slider(ui_ge[k]);
    a = ui_fxof(lo); b = ui_fxof(hi);
    near = 0; i = 0;
    loop(n - 1, abs(mouse_x - ui_fxof(slider(ui_ge[i]))) < 9 * ui_s ? near = 1; i += 1;);
    hot = !near && !(ui_core && ui_blocked) && !ui_modal && ui_active == 0 && mouse_x >= a && mouse_x < b
          && mouse_y >= ui_gy && mouse_y < ui_gy + ui_gh;
    hot && ui_press ? (
      ui_fsel = k; t = time_precise();
      sh = mouse_cap & 8;   // Shift: this drag moves the band's gain instead of its threshold
      (mouse_cap & 52) ? ui_reset(sh ? gdx : idx) :
      (ui_lci == idx && t - ui_lct < 0.45) ? ui_edopen(idx, 1, "Threshold", (a + b) / 2, ui_gyof(slider(idx))) :
      ( ui_active = sh ? gdx : idx; ui_ftd = 1; ui_ly = mouse_y; ui_acc = slider(ui_active); ui_lci = idx; ui_lct = t; );
      ui_press = 0;
    );
    ui_ftd && ui_active == idx && ui_down ? (   // only a drag this widget started: a band knob on the same slider drags itself
      ui_acc = min(ui_max[idx], max(ui_min[idx], ui_acc - (mouse_y - ui_ly) * 72 / ui_gh));
      ui_ly = mouse_y;
      ui_set(idx, ui_q(idx, ui_acc));
    );
    hot && mouse_wheel != 0 ? ui_set(rdx, ui_q(rdx, slider(rdx) + sign(mouse_wheel) * 0.5));
    ui_ftd && ui_active == gdx && ui_down ? (
      ui_acc = min(ui_max[gdx], max(ui_min[gdx], ui_acc - (mouse_y - ui_ly) * 0.15));
      ui_ly = mouse_y;
      ui_set(gdx, ui_q(gdx, ui_acc));
    );
    ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; ui_ftd = 0; );
    ui_active == gdx && ui_rel ? ( slider_automate(2 ^ (gdx - 1), 1); ui_active = 0; ui_ftd = 0; );
    gdrag = ui_active == gdx; drag = ui_active == idx || gdrag;
    (hot || drag) ? ui_gany = 2;
    sel = k == ui_fsel;
    // the band's wash when hovered, then its threshold line (bright when selected)
    (hot || drag) ? ( ui_c(ui_cAccent, 0.07); gfx_rect(a, ui_gy, max(1, b - a), ui_gh); );
    y = ui_gyof(slider(idx));
    ui_c(drag ? ui_cAccentAct : (sel || hot ? ui_cAccentHi : ui_cAccent), drag ? 1 : (sel ? 0.95 : (hot ? 0.8 : 0.4)));
    gfx_rect(a + 2 * ui_s, y, max(1, b - a - 4 * ui_s), max(1, sel ? 2 * ui_s : ui_s));
    (sel || hot || drag) && b - a > 60 * ui_s ? (
      gfx_setfont(2);
      (gdrag || (hot && (mouse_cap & 8) && !drag)) ? sprintf(#ui_txt, "%+.1f dB gain", slider(gdx)) :
        sprintf(#ui_txt, "%.0f dB  %.1f:1", slider(idx), slider(rdx));
      gfx_measurestr(#ui_txt, ui_tw, ui_th);
      ui_c(drag || sel ? ui_cAccent : ui_cText, 1);
      gfx_x = a + 6 * ui_s; gfx_y = y - ui_th - 3 * ui_s; gfx_drawstr(#ui_txt);
      gfx_setfont(1);
    );
    k += 1;
  );
);

// ---- per-band levels --------------------------------------------------------------------------------

// A level line across each band of the frequency graph, one slider per band (first_idx .. first_idx + n - 1, any
// range, drawn across the graph's height), for a plugin whose bands each have one amount (an EQ's gain, a split's
// level). Hover a band and drag up or down to change its level, Shift-drag for fine steps, wheel for small steps,
// a click selects the band (ui_fsel, which ui_bandknob follows), double-click types a value, Cmd/Ctrl/Alt-click
// resets it. fmt is the knob formats (1 = dB). n is the number of bands (the handles + 1). Call it after the handles.
function ui_fband(first_idx, n, fmt) local(k, a, b, y, idx, lo, hi, hot, drag, near, i, sel, t, mn, mx) (
  n = max(1, min(8, floor(n)));
  k = 0;
  loop(n,
    idx = first_idx + k; mn = ui_min[idx]; mx = ui_max[idx];
    lo = k == 0 ? 20 : slider(ui_ge[k - 1]); hi = k == n - 1 ? 20000 : slider(ui_ge[k]);
    a = ui_fxof(lo); b = ui_fxof(hi);
    y = ui_gy + ui_gh * (1 - (slider(idx) - mn) / (mx - mn));
    near = 0; i = 0;
    loop(n - 1, abs(mouse_x - ui_fxof(slider(ui_ge[i]))) < 9 * ui_s ? near = 1; i += 1;);
    hot = !near && !(ui_core && ui_blocked) && !ui_modal && ui_active == 0 && mouse_x >= a && mouse_x < b
          && mouse_y >= ui_gy && mouse_y < ui_gy + ui_gh;
    hot && ui_press ? (
      ui_fsel = k; t = time_precise();
      (mouse_cap & 52) ? ui_reset(idx) :
      (ui_lci == idx && t - ui_lct < 0.45) ? ui_edopen(idx, fmt, "Level", (a + b) / 2, y) :
      ( ui_active = idx; ui_ftd = 1; ui_ly = mouse_y; ui_acc = slider(idx); ui_lci = idx; ui_lct = t; );
      ui_press = 0;
    );
    ui_ftd && ui_active == idx && ui_down ? (   // only a drag this widget started
      ui_acc = min(mx, max(mn, ui_acc - (mouse_y - ui_ly) * (mx - mn) / ui_gh * ((mouse_cap & 8) ? 0.2 : 1)));
      ui_ly = mouse_y;
      ui_set(idx, ui_q(idx, ui_acc));
    );
    hot && mouse_wheel != 0 ? ui_set(idx, ui_q(idx, slider(idx) + sign(mouse_wheel) * (ui_stp[idx] > 0 ? ui_stp[idx] : (mx - mn) / 48)));   // a stepped slider moves one step, or ui_q would round the nudge away
    ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; ui_ftd = 0; );
    drag = ui_active == idx;
    (hot || drag) ? ui_gany = 2;
    sel = k == ui_fsel;
    y = ui_gy + ui_gh * (1 - (slider(idx) - mn) / (mx - mn));
    (hot || drag) ? ( ui_c(ui_cAccent, 0.07); gfx_rect(a, ui_gy, max(1, b - a), ui_gh); );
    ui_c(drag ? ui_cAccentAct : (sel || hot ? ui_cAccentHi : ui_cAccent), drag ? 1 : (sel ? 0.95 : (hot ? 0.8 : 0.4)));
    gfx_rect(a + 2 * ui_s, y, max(1, b - a - 4 * ui_s), max(1, sel ? 2 * ui_s : ui_s));
    (sel || hot || drag) && b - a > 50 * ui_s ? (
      gfx_setfont(2);
      fmt == 1 ? sprintf(#ui_txt, "%+.1f dB", slider(idx)) : ui_fmtv(fmt, slider(idx));
      gfx_measurestr(#ui_txt, ui_tw, ui_th);
      ui_c(drag || sel ? ui_cAccent : ui_cText, 1);
      gfx_x = a + 6 * ui_s; gfx_y = max(ui_gy + 2 * ui_s, y - ui_th - 3 * ui_s); gfx_drawstr(#ui_txt);
      gfx_setfont(1);
    );
    k += 1;
  );
);

// A knob for the selected band's slider: slider first_idx + ui_fsel of n, its label prefixed with the
// band's name (Low / Mid / High for 3 bands, Low / High for 2, else Band N).
function ui_bandknob(first_idx, n, label, fmt) local(k) (
  n = max(1, floor(n)); k = max(0, min(floor(ui_fsel), n - 1));
  n == 3 ? strcpy(#ui_bn, k == 0 ? "Low" : (k == 1 ? "Mid" : "High")) :
  n == 2 ? strcpy(#ui_bn, k == 0 ? "Low" : "High") : sprintf(#ui_bn, "Band %d", k + 1);
  sprintf(#ui_bl, "%s %s", #ui_bn, label);
  ui_knob(first_idx + k, #ui_bl, fmt);
);

// ---- gain reduction ---------------------------------------------------------------------------------

// n bars (1..8) side by side, one per band, hanging from the top: the more reduction, the longer the
// bar (0..24 dB), amber from 6 dB, red from 12. Feed them with ui_gr(k, dB). A click on a bar selects
// that band like a click on the graph does (ui_fsel).
function ui_grmeter(n, label) local(k, bw, gap, gw, x0, x, h, v, fh, sw, bx, hit, selected) (
  ui_cell();
  n = max(1, min(8, floor(n)));
  bw = 10 * ui_s; gap = max(2 * ui_s, min(8 * ui_s, (ui_rw - 8 * ui_s - n * bw) / max(1, n - 1)));
  gw = n * bw + (n - 1) * gap; x0 = ui_rx + (ui_rw - gw) / 2; h = ui_bh;
  gfx_setfont(2);
  sw = (gw + gap) / n;
  k = 0;
  loop(n,
    bx = x0 + k * (bw + gap);
    hit = ui_hit && mouse_x >= bx - gap / 2 && mouse_x < bx + bw + gap / 2;
    hit && ui_press ? ( ui_fsel = k; ui_press = 0; );
    selected = k == ui_fsel;
    v = ui_grm[k]; fh = h * min(1, v / 24);
    ui_cm(ui_cPanel2, ui_cLine, 0.5); ui_rrect(bx, ui_by, bw, h, bw / 2);
    selected ? ( ui_c(ui_cAccent, 0.6); gfx_roundrect(bx - ui_s, ui_by - ui_s, bw + 2 * ui_s - 1, h + 2 * ui_s - 1, bw / 2 + ui_s, 1); );
    fh > 1 ? (
      ui_c(v >= 12 ? ui_cBad : (v >= 6 ? ui_cWarn : ui_cAccent), 1);
      ui_rrect(bx, ui_by, bw, fh, min(bw / 2, fh / 2));
    );
    sw >= 30 * ui_s ? sprintf(#ui_txt, "%.1f", v) : sprintf(#ui_txt, "%.0f", v);
    gfx_measurestr(#ui_txt, ui_tw, ui_th);
    ui_c(selected ? ui_cAccent : ui_cMuted, 1);
    gfx_x = bx + (bw - ui_tw) / 2; gfx_y = ui_by + ui_bh + 6 * ui_s + (ui_lh - ui_th) / 2; gfx_drawstr(#ui_txt);
    k += 1;
  );
  gfx_setfont(1);
  ui_label(label, 0);
);

// A compressor's transfer curve, input dB across and output dB up (-60..0), the 1:1 line behind it,
// the threshold marked on the axis, and a dot at the live input level (ui_glevel). thr_idx and
// ratio_idx are the first threshold (dB) and ratio sliders; with a frequency graph it shows the selected
// band's (slider + ui_fsel), knee_db the soft-knee width (0 = hard).
function ui_tcurve(x, t, r, w) local(d) (
  d = x - t;
  (w > 0 && d > 0 - w / 2 && d < w / 2) ? x + (1 / r - 1) * (d + w / 2) * (d + w / 2) / (2 * w) :
  d <= 0 ? x : t + d / r;
);
function ui_transfer(thr_idx, ratio_idx, knee_db) local(k, t, r, bs, bx, by, i, x, y, x0, y0, lv, ly, tx) (
  ui_cell();
  k = max(0, min(floor(ui_fsel), ui_gnb)); t = slider(thr_idx + k); r = max(1, slider(ratio_idx + k));
  bs = min(ui_rw - 16 * ui_s, ui_rh - 26 * ui_s);
  bs > 30 * ui_s ? (
    bx = ui_rx + (ui_rw - bs) / 2; by = ui_ry + 6 * ui_s;
    ui_cm(ui_cPanel2, ui_cLine, 0.3); ui_rrect(bx, by, bs, bs, 8 * ui_s);
    i = 1; loop(4, x = bx + bs * i / 5; ui_c(ui_cMuted, 0.1); gfx_rect(x, by, max(1, ui_s), bs); gfx_rect(bx, by + bs * i / 5, bs, max(1, ui_s)); i += 1;);
    ui_c(ui_cMuted, 0.3); gfx_line(bx, by + bs, bx + bs, by, 1);
    tx = bx + bs * (min(0, max(-60, t)) + 60) / 60;
    ui_c(ui_cWarn, 0.35); gfx_rect(tx, by, max(1, ui_s), bs);
    ui_c(ui_cLine, 1); gfx_roundrect(bx, by, bs - 1, bs - 1, 8 * ui_s, 1);
    // the curve
    x0 = bx; y0 = by + bs * (0 - ui_tcurve(-60, t, r, knee_db)) / 60; i = 1;
    loop(48,
      x = bx + bs * i / 48; y = by + bs * (0 - max(-60, ui_tcurve(-60 + 60 * i / 48, t, r, knee_db))) / 60;
      ui_c(ui_cAccent, 1); gfx_line(x0, y0, x, y, 1); gfx_line(x0, y0 + 1, x, y + 1, 1);
      x0 = x; y0 = y; i += 1;
    );
    // the live level
    ui_glv > -60 ? (
      lv = min(0, ui_glv); x = bx + bs * (lv + 60) / 60;
      ly = by + bs * (0 - max(-60, ui_tcurve(lv, t, r, knee_db))) / 60;
      ui_c(ui_cAccent, 0.3); gfx_rect(x, ly, max(1, ui_s), by + bs - ly);
      ui_c(ui_cAccent, 0.25); gfx_circle(x, ly, 6 * ui_s, 1, 1);
      ui_c(ui_cAccentAct, 1); gfx_circle(x, ly, 3.5 * ui_s, 1, 1);
    );
    gfx_setfont(2);
    sprintf(#ui_txt, "%.0f dB   %.1f:1", t, r);
    gfx_measurestr(#ui_txt, ui_tw, ui_th); ui_c(ui_cMuted, 1);
    gfx_x = ui_rx + (ui_rw - ui_tw) / 2; gfx_y = by + bs + 6 * ui_s; gfx_drawstr(#ui_txt);
    gfx_setfont(1);
  );
);

// ---- MIDI keyboard ------------------------------------------------------------------------------

// Piano keys lo..hi (MIDI notes; start and end on white keys: C, D, E, F, G, A, B), the notes fed with
// ui_kkey lit in the accent. Playable: a click or drag queues notes the plugin reads with ui_kpoll() in @block
// (a JSFX cannot send MIDI from @gfx, so the plugin sounds them itself).
function ui_keyboard(lo, hi, label) local(nw, n, pc, wi, ww, kx, ky, kw, kh, bk, x, v, k, hn, hw, vel) (
  ui_cell();
  nw = 0; n = lo;
  loop(hi - lo + 1, ((2 ^ (n % 12)) & 1354) ? 0 : nw += 1; n += 1;);
  kw = ui_rw - 8 * ui_s; kx = ui_rx + 4 * ui_s; ky = ui_ry + 16 * ui_s;
  kh = min(ui_rh - 20 * ui_s, 52 * ui_s);
  ky = ui_ry + ui_rh - kh - 4 * ui_s;   // along the bottom of its cell
  nw > 0 && kh > 16 * ui_s ? (
    ww = kw / nw;
    gfx_setfont(2); ui_caps(label);
    ui_c(ui_cMuted, 1); gfx_x = kx; gfx_y = ky - 14 * ui_s; gfx_drawstr(#ui_txt);
    gfx_setfont(1);
    hn = -1; hw = -1;
    // white keys
    wi = 0; n = lo;
    loop(hi - lo + 1,
      ((2 ^ (n % 12)) & 1354) ? 0 : (
        x = kx + wi * ww; v = ui_kb[n] > 0;
        mouse_x >= x && mouse_x < x + ww && mouse_y >= ky && mouse_y < ky + kh ? hw = n;
        v ? ui_c(ui_cAccent, 1) : ui_cm(ui_cPanel2, ui_cText, 0.82);
        ui_rrect(x + 0.5 * ui_s, ky, ww - ui_s, kh, 3 * ui_s);
        wi += 1;
      );
      n += 1;
    );
    // black keys on top, centred on the boundary after the white key before them
    wi = 0; n = lo;
    loop(hi - lo + 1,
      ((2 ^ (n % 12)) & 1354) ? (
        wi > 0 ? (
          bk = ww * 0.6; x = kx + wi * ww - bk / 2; v = ui_kb[n] > 0;
          mouse_x >= x && mouse_x < x + bk && mouse_y >= ky && mouse_y < ky + kh * 0.62 ? hn = n;
          ui_c(ui_cLine, 1); ui_rrect(x - ui_s, ky, bk + 2 * ui_s, kh * 0.62 + ui_s, 3 * ui_s);
          v ? ui_cm(ui_cAccent, ui_cBg, 0.35) : ui_cm(ui_cBg, ui_cPanel2, 0.5);
          ui_rrect(x, ky, bk, kh * 0.62, 3 * ui_s);
        );
      ) : wi += 1;
      n += 1;
    );
    // play the keys: press = note on (higher up the key = softer), drag across keys = glissando, release = note off
    hn < 0 ? hn = hw;
    vel = floor(35 + 92 * min(1, max(0, (mouse_y - ky) / kh)));
    hn >= 0 && ui_active == 0 && ui_press && !(ui_core && ui_blocked) && !ui_modal ? (
      ui_active = 64; ui_kheld = hn + 1; ui_kput(hn, vel); ui_kkey(hn, vel); ui_press = 0;
    );
    ui_active == 64 && ui_down && hn >= 0 && hn + 1 != ui_kheld ? (
      ui_kput(ui_kheld - 1, 0); ui_kkey(ui_kheld - 1, 0);
      ui_kheld = hn + 1; ui_kput(hn, vel); ui_kkey(hn, vel);
    );
    ui_active == 64 && !ui_down ? (
      ui_kput(ui_kheld - 1, 0); ui_kkey(ui_kheld - 1, 0); ui_kheld = 0; ui_active = 0;
    );
  );
);

// ---- drum pads ----------------------------------------------------------------------------------

// A bank of drum pads: `cols` x `rows` (at most 16 pads), pad 1 bottom-left on MIDI note `first` (36 = GM kick),
// counting right then up. Playable: a press strikes the pad (lower on the pad = harder), a drag across pads moves
// the hit, a release lets go; the typed keys strike them too. Pads light, brighter the harder, for the notes
// fed with ui_kkey (MIDI in) and the ones the user strikes. Read what the user struck in @block with
// `while (ui_kpoll()) ( ... )`, as for ui_keyboard. Give the row some height (ui_tall(2)).
function ui_pads(first, cols, rows, label) local(gx, gy, gw, gh, gap, pw, ph, i, col, row, x, y, v, hov, hot, vel) (
  ui_cell();
  ui_pcols = min(8, max(1, floor(cols))); ui_prows = min(8, max(1, floor(rows)));
  while (ui_pcols * ui_prows > 16) ( ui_prows -= 1; );
  ui_pn = min(127 - ui_pcols * ui_prows + 1, max(0, floor(first)));
  ui_pc = ui_pcols * ui_prows;
  gap = 6 * ui_s; gx = ui_rx + 4 * ui_s; gw = ui_rw - 8 * ui_s;
  gy = ui_ry + 16 * ui_s; gh = ui_rh - 20 * ui_s;
  pw = (gw - gap * (ui_pcols - 1)) / ui_pcols; ph = (gh - gap * (ui_prows - 1)) / ui_prows;
  pw > 10 * ui_s && ph > 10 * ui_s ? (
    gfx_setfont(2); ui_caps(label);
    ui_c(ui_cMuted, 1); gfx_x = gx; gfx_y = ui_ry + 2 * ui_s; gfx_drawstr(#ui_txt);
    hot = -1; i = 0;
    loop(ui_pc,
      col = i % ui_pcols; row = floor(i / ui_pcols);
      x = gx + col * (pw + gap); y = gy + gh - (row + 1) * ph - row * gap;
      hov = mouse_x >= x && mouse_x < x + pw && mouse_y >= y && mouse_y < y + ph;
      hov ? ( hot = i; vel = floor(35 + 92 * min(1, max(0, (mouse_y - y) / ph))); );
      v = ui_kb[ui_pn + i];
      ui_c(ui_cLine, 1); ui_rrect(x - ui_s, y - ui_s, pw + 2 * ui_s, ph + 2 * ui_s, 7 * ui_s);
      v > 0 ? ui_cm(ui_cPanel2, ui_cAccent, 0.35 + 0.65 * v / 127) : hov ? ui_cm(ui_cPanel2, ui_cText, 0.08) : ui_c(ui_cPanel2, 1);
      ui_rrect(x, y, pw, ph, 6 * ui_s);
      // the typed key in the corner (the 4 x 4 block), the note bottom-right
      gfx_setfont(5);
      v > 0 ? ui_cm(ui_cBg, ui_cPanel2, 0.2) : ui_c(ui_cMuted, 1);
      col < 4 && row < 4 ? (
        strcpy_substr(#ui_pt, #ui_pkeys, row * 4 + col, 1); ui_caps(#ui_pt);
        gfx_x = x + 6 * ui_s; gfx_y = y + 5 * ui_s; gfx_drawstr(#ui_txt);
      );
      sprintf(#ui_txt, "%d", ui_pn + i);
      gfx_measurestr(#ui_txt, ui_tw, ui_th);
      gfx_x = x + pw - ui_tw - 6 * ui_s; gfx_y = y + ph - ui_th - 5 * ui_s; gfx_drawstr(#ui_txt);
      i += 1;
    );
    gfx_setfont(1);
    // strike: press = hit (lower on the pad = harder), drag across pads moves the hit, release lets go
    hot >= 0 && ui_active == 0 && ui_press && !(ui_core && ui_blocked) && !ui_modal ? (
      ui_active = 65; ui_pheld = hot + 1; ui_padon(hot, vel); ui_press = 0;
    );
    ui_active == 65 && ui_down && hot >= 0 && hot + 1 != ui_pheld ? (
      ui_padoff(ui_pheld - 1); ui_pheld = hot + 1; ui_padon(hot, vel);
    );
    ui_active == 65 && !ui_down ? (
      ui_pheld > 0 ? ui_padoff(ui_pheld - 1); ui_pheld = 0; ui_active = 0;
    );
  );
);

// ---- pad map ------------------------------------------------------------------------------------

// A note's name in #ui_txt, middle C = C4 (so MIDI 36 is C2, as REAPER shows it).
function ui_notename(n) local(pc) (
  pc = floor(n) % 12;
  strcpy_substr(#ui_nn, "C C#D D#E F F#G G#A A#B ", pc * 2, ((2 ^ pc) & 1354) ? 2 : 1);
  sprintf(#ui_txt, "%s%d", #ui_nn, floor(n / 12) - 1);
);

// Which MIDI note each pad sends, drawn in the same grid as ui_pads (`cols` x `rows`, pad 1 bottom-left) so a
// cell sits where its pad is. One slider per pad, first_idx.. in pad order, each a note 0-127. Every cell shows
// the note's name large and its number small. Drag a cell up or down (Shift = fine), scroll over it (Shift =
// an octave), double-click to type a number, Cmd/Ctrl/Alt-click resets it. Put it in Advanced next to a
// ui_pads core.
function ui_padmap(first_idx, cols, rows, label) local(gx, gy, gw, gh, gap, pw, ph, i, col, row, x, y, idx, v, hov, now, on, hint) (
  ui_cell();
  cols = min(8, max(1, floor(cols))); rows = min(8, max(1, floor(rows)));
  while (cols * rows > 16) ( rows -= 1; );
  gap = 6 * ui_s; gx = ui_rx + 4 * ui_s; gw = ui_rw - 8 * ui_s;
  gy = ui_ry + 16 * ui_s; gh = ui_rh - 20 * ui_s;
  pw = (gw - gap * (cols - 1)) / cols; ph = (gh - gap * (rows - 1)) / rows;
  hint = 0;
  pw > 14 * ui_s && ph > 14 * ui_s ? (
    gfx_setfont(2); ui_caps(label);
    ui_c(ui_cMuted, 1); gfx_x = gx; gfx_y = ui_ry + 2 * ui_s; gfx_drawstr(#ui_txt);
    now = time_precise(); i = 0;
    loop(cols * rows,
      col = i % cols; row = floor(i / cols); idx = first_idx + i;
      x = gx + col * (pw + gap); y = gy + gh - (row + 1) * ph - row * gap;
      hov = mouse_x >= x && mouse_x < x + pw && mouse_y >= y && mouse_y < y + ph && !(ui_core && ui_blocked) && !ui_modal;
      hov && ui_press ? (
        (mouse_cap & 52) ? ui_reset(idx) :
        (ui_lci == idx && now - ui_lct < 0.45) ? ui_edopen(idx, 5, "Note", x, y) :
        ( ui_active = idx; ui_ly = mouse_y; ui_acc = slider(idx); ui_lci = idx; ui_lct = now; );
      );
      ui_active == idx && ui_down ? (
        ui_acc = min(127, max(0, ui_acc + (ui_ly - mouse_y) / (9 * ui_s * ((mouse_cap & 8) ? 10 : 1))));
        ui_ly = mouse_y;
        ui_set(idx, ui_q(idx, floor(ui_acc + 0.5)));
      );
      hov && mouse_wheel != 0 ? ui_set(idx, ui_q(idx, slider(idx) + sign(mouse_wheel) * ((mouse_cap & 8) ? 12 : 1)));
      ui_active == idx && ui_rel ? ( slider_automate(2 ^ (idx - 1), 1); ui_active = 0; );
      v = slider(idx); on = ui_active == idx;
      on || ui_kb[ui_pn + i] > 0 ? ui_c(ui_cAccent, 1) : ui_c(ui_cLine, 1); ui_rrect(x - ui_s, y - ui_s, pw + 2 * ui_s, ph + 2 * ui_s, 7 * ui_s);
      ui_kb[ui_pn + i] > 0 ? ui_cm(ui_cPanel2, ui_cAccent, 0.35 + 0.65 * ui_kb[ui_pn + i] / 127) : on ? ui_cm(ui_cPanel2, ui_cAccent, 0.2) : hov ? ui_cm(ui_cPanel2, ui_cText, 0.08) : ui_c(ui_cPanel2, 1);
      ui_rrect(x, y, pw, ph, 6 * ui_s);
      gfx_setfont(5); ui_c(ui_cMuted, 1);
      sprintf(#ui_txt, "%s %d", #ui_pword, i + 1); ui_caps(#ui_txt); gfx_x = x + 6 * ui_s; gfx_y = y + 5 * ui_s; gfx_drawstr(#ui_txt);
      sprintf(#ui_txt, "%d", v); gfx_measurestr(#ui_txt, ui_tw, ui_th);
      gfx_x = x + pw - ui_tw - 6 * ui_s; gfx_y = y + ph - ui_th - 5 * ui_s; gfx_drawstr(#ui_txt);
      gfx_setfont(4); ui_notename(v);
      hov || on ? ui_c(ui_cAccent, 1) : ui_c(ui_cText, 1);
      gfx_measurestr(#ui_txt, ui_tw, ui_th);
      gfx_x = x + (pw - ui_tw) / 2; gfx_y = y + (ph - ui_th) / 2; gfx_drawstr(#ui_txt);
      // hover or drag: arrows above and below the note say it can be dragged up and down
      hov || on ? (
        hint = 1;
        ui_c(ui_cAccent, on ? 1 : 0.85);
        ui_chev(x + pw / 2, y + (ph - ui_th) / 2 - 7 * ui_s, 1);
        ui_chev(x + pw / 2, y + (ph + ui_th) / 2 + 7 * ui_s, 0);
      );
      i += 1;
    );
    // the gestures, on the label line, while the mouse is over a cell
    hint ? (
      gfx_setfont(5); ui_c(ui_cMuted, 1);
      strcpy(#ui_txt, "DRAG OR SCROLL  /  DOUBLE-CLICK TO TYPE");
      gfx_measurestr(#ui_txt, ui_tw, ui_th);
      gfx_x = gx + gw - ui_tw; gfx_y = ui_ry + 3 * ui_s; gfx_drawstr(#ui_txt);
    );
    gfx_setfont(1);
  );
);

// ---- step sequencer -----------------------------------------------------------------------------

// A loop of notes on up to 8 lanes, in ticks (96 per quarter note). A note's length is a code value * 3 + feel:
// value 0..3 = 1/4 1/8 1/16 1/32, feel 0 straight, 1 triplet, 2 dotted. The plugin owns the buffer `buf` (800
// numbers at most: ui_mem..ui_mem + 799); per lane: [0] note count, [1] muted, then up to 32 notes of (start tick,
// code, velocity). buf[0] is the loop length in ticks; lane l starts at buf + 8 + l * 98.
function ui_sqlen(c) local(v, f) (
  v = floor(c / 3); f = c - v * 3;
  floor(96 / (2 ^ v) * (f == 1 ? 2 / 3 : f == 2 ? 1.5 : 1) + 0.5);
);
function ui_sqfeel(c) ( c - floor(c / 3) * 3; );
// the note length's name in #ui_txt: 1/16, 1/8T, 1/8D
function ui_sqname(c) local(v, f) (
  v = floor(c / 3); f = c - v * 3;
  sprintf(#ui_txt, "1/%d", 4 * (2 ^ v));
  f == 1 ? strcat(#ui_txt, "T") : f == 2 ? strcat(#ui_txt, "D");
);
function ui_sqlane(l) ( ui_sqb + 8 + l * 98; );
// Empties the pattern and sets its shape: call once in @init (guarded, so a rerun on Play keeps the notes).
function ui_sqclear(buf, lanes, ticks) local(i, p) (
  ui_sqb = buf; ui_sqnl = max(1, min(8, floor(lanes))); ui_sqb[0] = ticks; ui_sqb[2] = 0;
  i = 0; loop(ui_sqnl, p = ui_sqlane(i); p[0] = 0; p[1] = 0; i += 1;);
  ui_sqdesel();
);
// the note of lane l that starts at tick s, -1 for none
function ui_sqat(l, s) local(p, i, r) (
  p = ui_sqlane(l); r = -1; i = 0;
  loop(p[0], p[2 + i * 3] == s ? r = i; i += 1;);
  r;
);
// A note at tick s (one already there is replaced); returns its index, -1 when the lane is full (32 notes).
function ui_sqadd(l, s, c, v) local(p, n, i) (
  p = ui_sqlane(l); n = p[0]; i = ui_sqat(l, s);
  i >= 0 ? ( p[3 + i * 3] = c; p[4 + i * 3] = v; i; ) :
  n < 32 ? ( p[2 + n * 3] = s; p[3 + n * 3] = c; p[4 + n * 3] = v; p[0] = n + 1; ui_sqsl[l * 32 + n] = 0; n; ) : -1;
);
// Removes note i (the last one takes its place, so indexes shift).
function ui_sqdel(l, i) local(p, k) (
  p = ui_sqlane(l); k = p[0] - 1;
  i >= 0 && i <= k ? (
    p[2 + i * 3] = p[2 + k * 3]; p[3 + i * 3] = p[3 + k * 3]; p[4 + i * 3] = p[4 + k * 3];
    ui_sqsl[l * 32 + i] = ui_sqsl[l * 32 + k]; ui_sqsl[l * 32 + k] = 0;
    p[0] = k;
  );
);
// the note covering tick t (latest start wins; one shorter than `slack` ticks still counts as that wide), -1 for none
function ui_sqfind(l, t, slack) local(p, i, s, best) (
  p = ui_sqlane(l); best = -1; i = 0;
  loop(p[0],
    s = p[2 + i * 3];
    t >= s && t < s + max(slack, ui_sqlen(p[3 + i * 3])) && (best < 0 || s > p[2 + best * 3]) ? best = i;
    i += 1;
  );
  best;
);
// the length code of the value with this feel that is closest to `len` ticks
function ui_sqnear(len, feel) local(best, d, v) (
  best = feel; d = abs(ui_sqlen(feel) - len); v = 1;
  loop(3,
    abs(ui_sqlen(v * 3 + feel) - len) < d ? ( best = v * 3 + feel; d = abs(ui_sqlen(best) - len); );
    v += 1;
  );
  best;
);
// the grid cell the pointer is in (its left edge), the place a new note goes
function ui_sqcell(t, st) ( min(ui_sqb[0] - 1, max(0, floor(t / st) * st)); );
function ui_sqsnap(t, st) ( min(ui_sqb[0] - 1, max(0, floor(t / st + 0.5) * st)); );

// Remembers where every selected note starts: a drag moves them all from here.
function ui_sqorg() local(l, i, p) (
  l = 0; loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqor[l * 32 + i] = p[2 + i * 3]; i += 1;); l += 1;);
);
// Moves the selected notes to their remembered starts + delta ticks, all by the same amount, kept inside the loop;
// nothing moves when a note would land on one that is not selected.
function ui_sqshift(delta) local(l, i, p, lo, hi, ok, o) (
  lo = 99999; hi = -1; l = 0;
  loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqsl[l * 32 + i] ? ( lo = min(lo, ui_sqor[l * 32 + i]); hi = max(hi, ui_sqor[l * 32 + i]); ); i += 1;); l += 1;);
  hi >= 0 ? (
    delta = max(-lo, min(ui_sqb[0] - 1 - hi, delta));
    ok = 1; l = 0;
    loop(ui_sqnl, p = ui_sqlane(l); i = 0;
      loop(p[0],
        ui_sqsl[l * 32 + i] ? ( o = ui_sqat(l, ui_sqor[l * 32 + i] + delta); o >= 0 && !ui_sqsl[l * 32 + o] ? ok = 0; );
        i += 1;
      );
      l += 1;
    );
    ok ? (
      l = 0;
      loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqsl[l * 32 + i] ? p[2 + i * 3] = ui_sqor[l * 32 + i] + delta; i += 1;); l += 1;);
    );
  );
);
// How many notes of lane l are selected.
function ui_sqlsel(l) local(i, n, p) (
  p = ui_sqlane(l); n = 0; i = 0; loop(p[0], n += ui_sqsl[l * 32 + i] ? 1 : 0; i += 1;); n;
);
// Moves every selected note dl lanes (up or down, same start, length and velocity). Nothing moves, and 0 comes
// back, when one would leave the lanes, land on a note that stays, or overfill a lane (32 notes).
function ui_sqlanes(dl) local(l, t, i, p, q, ok, s, c, v, o) (
  ok = dl != 0; l = 0;
  loop(ui_sqnl,
    p = ui_sqlane(l); t = l + dl;
    ui_sqlsel(l) > 0 ? (
      t < 0 || t >= ui_sqnl ? ok = 0 : (
        i = 0;
        loop(p[0],
          ui_sqsl[l * 32 + i] ? ( o = ui_sqat(t, p[2 + i * 3]); o >= 0 && !ui_sqsl[t * 32 + o] ? ok = 0; );
          i += 1;
        );
        q = ui_sqlane(t); q[0] - ui_sqlsel(t) + ui_sqlsel(l) > 32 ? ok = 0;
      );
    );
    l += 1;
  );
  ok ? (
    l = dl > 0 ? ui_sqnl - 1 : 0;
    loop(ui_sqnl,
      p = ui_sqlane(l); i = p[0] - 1;
      loop(p[0],
        i >= 0 && ui_sqsl[l * 32 + i] ? (
          s = p[2 + i * 3]; c = p[3 + i * 3]; v = p[4 + i * 3];
          ui_sqdel(l, i);
          o = ui_sqadd(l + dl, s, c, v); o >= 0 ? ui_sqsl[(l + dl) * 32 + o] = 1;
        );
        i -= 1;
      );
      l += dl > 0 ? -1 : 1;
    );
  );
  ok;
);
// Adjustments act on the whole selection. ui_sqvorg remembers the selected notes' velocities as a drag starts, ui_sqvel
// sets each to that + delta (kept 1..127), ui_sqsetlen gives every selected note the length code c, and ui_sqadj
// steps the length (or, with vel, the velocity) of a scrolled note, and of the whole selection when that note is in it.
function ui_sqvorg() local(l, i, p) (
  l = 0; loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqor[l * 32 + i] = p[4 + i * 3]; i += 1;); l += 1;);
);
function ui_sqvel(delta) local(l, i, p) (
  l = 0; loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqsl[l * 32 + i] ? p[4 + i * 3] = min(127, max(1, ui_sqor[l * 32 + i] + delta)); i += 1;); l += 1;);
);
function ui_sqsetlen(c) local(l, i, p) (
  l = 0; loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], ui_sqsl[l * 32 + i] ? p[3 + i * 3] = c; i += 1;); l += 1;);
);
function ui_sqadj(ln, hi, d, vel, step) local(l, i, p, all) (
  all = ui_sqsl[ln * 32 + hi];
  l = 0;
  loop(ui_sqnl,
    p = ui_sqlane(l); i = 0;
    loop(p[0],
      (all ? ui_sqsl[l * 32 + i] : l == ln && i == hi) ? (
        vel ? p[4 + i * 3] = min(127, max(1, p[4 + i * 3] - d * step)) :
              p[3 + i * 3] = min(3, max(0, floor(p[3 + i * 3] / 3) + d)) * 3 + ui_sqfeel(p[3 + i * 3]);
      );
      i += 1;
    );
    l += 1;
  );
);
// Selects the notes that overlap lanes l0..l1 and ticks t0..t1 (add = keep the ones already selected).
function ui_sqmarq(l0, l1, t0, t1, add) local(l, i, p, s, inside) (
  l = 0;
  loop(ui_sqnl,
    p = ui_sqlane(l); i = 0;
    loop(p[0],
      s = p[2 + i * 3];
      inside = l >= l0 && l <= l1 && s < t1 && s + ui_sqlen(p[3 + i * 3]) > t0;
      add ? ( inside ? ui_sqsl[l * 32 + i] = 1; ) : ( ui_sqsl[l * 32 + i] = inside; );
      i += 1;
    );
    l += 1;
  );
);
function ui_sqcount() local(l, i, p, n) (
  n = 0; l = 0; loop(ui_sqnl, p = ui_sqlane(l); i = 0; loop(p[0], n += ui_sqsl[l * 32 + i] ? 1 : 0; i += 1;); l += 1;);
  n;
);

// A small button; returns 1 on the frame it is pressed.
function ui_sqchip(x, y, w, h, on, label) local(hov) (
  hov = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h && !(ui_core && ui_blocked) && !ui_modal;
  on ? ui_c(ui_cAccent, 1) : hov ? ui_cm(ui_cPanel2, ui_cText, 0.12) : ui_c(ui_cPanel2, 1);
  ui_rrect(x, y, w, h, 4 * ui_s);
  gfx_setfont(5); ui_c(on ? ui_cBg : hov ? ui_cText : ui_cMuted, 1);
  strcpy(#ui_txt, label); ui_ctext(x, y, w, h);
  hov && ui_press && ui_active == 0 ? ( ui_press = 0; 1; ) : 0;
);

// The note colour: straight = the accent, triplet = green, dotted = amber.
function ui_sqcol(f) ( f == 1 ? ui_cLive : f == 2 ? ui_cWarn : ui_cAccent; );

// The pattern editor. `buf` is the plugin's buffer (see above), `lanes` 1-8, `note_idx` the first of `lanes` sliders
// holding each lane's MIDI note (shown beside the lane; click it to hear it, Cmd/Ctrl-click to mute the lane).
// Give it a tall row (ui_tall(3)). Set ui_sqph in @block (the loop tick of the playhead, -1 when stopped) and read the
// notes there; light a lane from @block with ui_kkey(lane, vel). Put ui_padmap(note_idx, lanes, 1, ...) in Advanced.
//
// Like REAPER's MIDI editor: a click on empty space adds a note, a drag makes a selection (a marquee), Shift-drag
// paints a run of notes, Delete (or Backspace, or the DELETE button) removes the selected notes, Cmd/Ctrl+A selects
// all, and dragging a selected note moves the whole selection. A BRUSH sets what a click or a painted run adds: a
// length (the 1/4 .. 1/32 buttons, keys 1-4, or scroll over empty space) and a feel (straight / triplet / dotted
// buttons, keys q w e). Shift and Alt never change the feel, so a Shift-drag paints in the brush's own value; the
// grid redraws on the lines of what you are about to place. On a note: Cmd/Ctrl-click adds it to the selection, drag = move, Shift-drag = velocity (up/down), drag its right edge to
// resize, scroll = length (Cmd/Ctrl-scroll = velocity), right-click or double-click deletes it, and Alt/Option-drag erases every note the pointer crosses. Cmd/Ctrl while placing
// or moving ignores the grid.
function ui_seq(buf, lanes, note_idx, label) local(ux, gx, gw, gy, rh, lw, lt, nl, hov, ln, t, hi, p, k, i, l, x, y, w, h, c, v, fe, st, s, d, dx, dy, ns, o, e, f2, now, edge, ex, cx, cw, ch, n, hint, base, rhov, uhov) (
  ui_cell();
  ui_sqb = buf; ui_sqnl = max(1, min(8, floor(lanes))); nl = ui_sqnl; ui_sqon = nl;
  ui_pn = 0; strcpy(#ui_pword, "LANE");   // a ui_padmap beside it lights lane i like note i
  lt = ui_sqb[0]; now = time_precise();
  fe = ui_sqbf;
  lw = 40 * ui_s; gx = ui_rx + 4 * ui_s + lw; gw = ui_rw - 8 * ui_s - lw;
  gy = ui_ry + 33 * ui_s; rh = (ui_ry + ui_rh - 16 * ui_s - gy) / nl;
  gw > 60 * ui_s && rh > 12 * ui_s ? (
    // header: the label and the brush buttons (length, then feel)
    gfx_setfont(2); ui_caps(label); ui_c(ui_cMuted, 1);
    gfx_x = ui_rx + 4 * ui_s; gfx_y = ui_ry + 5 * ui_s; gfx_drawstr(#ui_txt);
    cw = 31 * ui_s; ch = 17 * ui_s; cx = ui_rx + ui_rw - 4 * ui_s - 3 * 29 * ui_s - 4 * cw - 8 * ui_s;
    ui_rw > 300 * ui_s ? (
      i = 0; loop(4,
        ui_sqname(i * 3 + 0); ui_sqchip(cx + i * cw, ui_ry + 2 * ui_s, cw - 2 * ui_s, ch, i == ui_sqbl, #ui_txt) ? ( ui_sqbl = i; );
        i += 1;
      );
      cx += 4 * cw + 8 * ui_s;
      i = 0; loop(3,
        ui_sqchip(cx + i * 29 * ui_s, ui_ry + 2 * ui_s, 27 * ui_s, ch, i == fe, i == 0 ? "STR" : i == 1 ? "TRI" : "DOT") ? ( ui_sqbf = i; );
        i += 1;
      );
    );

    // pointer: where it is on the grid, which note it is over
    hov = mouse_x >= gx && mouse_x < gx + gw && mouse_y >= gy && mouse_y < gy + rh * nl && !(ui_core && ui_blocked) && !ui_modal && (ui_active == 0 || ui_active == 66);
    ln = hov ? min(nl - 1, floor((mouse_y - gy) / rh)) : -1;
    t = (mouse_x - gx) / gw * lt;
    hi = hov ? ui_sqfind(ln, t, 6 * ui_s / gw * lt) : -1;
    edge = 0;
    hi >= 0 ? (
      p = ui_sqlane(ln);
      ex = gx + (p[2 + hi * 3] + ui_sqlen(p[3 + hi * 3])) / lt * gw;
      edge = ui_sqlen(p[3 + hi * 3]) / lt * gw > 14 * ui_s && mouse_x >= ex - 5 * ui_s;
    );
    hov && edge && ui_active == 0 ? ui_gany = 1;

    // press: a note (toggle its feel, select it, or start a drag), or empty space (a click adds a note, a drag selects,
    // Shift-drag paints a run)
    ui_active != 66 ? ui_sqpd = 0;
    // the ruler above the grid: a click sets where playing starts (header slot 2, in ticks; the same spot again, or beat 1, clears it)
    rhov = ui_active == 0 && mouse_x >= gx && mouse_x < gx + gw && mouse_y >= gy - 14 * ui_s && mouse_y < gy && !(ui_core && ui_blocked) && !ui_modal;
    rhov && ui_press ? (
      ui_press = 0;
      s = min(lt - 24, max(0, floor(t / 24 + 0.5) * 24));
