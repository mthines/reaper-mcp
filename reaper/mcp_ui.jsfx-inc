          ui_sqs0 = ui_sqpcm ? min(lt - 1, max(0, floor(ui_sqpt + 0.5))) : ui_sqcell(ui_sqpt, ui_sqst);
          ui_sqk = 0; ui_sqpush1(); ui_sqdesel(); ui_sqadd(ui_sqln, ui_sqs0, ui_sqcode, 100); ui_kput(slider(note_idx + ui_sqln), 100);
          ui_sqmode = 1;
