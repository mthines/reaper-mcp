        i = ui_sqfind(ln, t, 6 * ui_s / gw * lt); i >= 0 ? ( ui_sqpush1(); ui_sqdel(ln, i); );
      );
      ui_sqmode == 6 && (abs(dx) >= 4 * ui_s || abs(dy) >= 4 * ui_s) ? (
