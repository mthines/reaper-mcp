    ui_sqchip(ui_rx + ui_rw - 4 * ui_s - 44 * ui_s, y - 1 * ui_s, 44 * ui_s, 14 * ui_s, ui_sqsure > 0, ui_sqsure > 0 ? "SURE?" : "CLEAR") ? (
      ui_sqsure > 0 ? (
