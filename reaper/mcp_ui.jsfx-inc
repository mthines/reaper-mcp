    );
    hov && ui_press && ui_active == 0 ? (
      ui_press = 0;
      hi < 0 ? (
        ui_active = 66; ui_sqmode = 6; ui_sqln = ln; ui_sqx0 = mouse_x; ui_sqy0 = mouse_y;
        ui_sqpt = t; ui_sqfe = fe; ui_sqpsh = mouse_cap & 8; ui_sqpal = mouse_cap & 16; ui_sqpcm = mouse_cap & 4;
      ) : (
        p = ui_sqlane(ln); k = p + 3 + hi * 3; cx = ln * 10000 + p[2 + hi * 3];
        (ui_sqcid == cx && now - ui_sqct < 0.35) ? (
          ui_sqpush(); ui_sqdel(ln, hi); ui_sqcid = -1;
        ) : (
          ui_sqcid = cx; ui_sqct = now;
          // Cmd/Ctrl toggles this note in the selection; otherwise it becomes the selection unless it is part of it
          (mouse_cap & 4) ? ui_sqsl[ln * 32 + hi] = !ui_sqsl[ln * 32 + hi] :
          !ui_sqsl[ln * 32 + hi] ? ( ui_sqdesel(); ui_sqsl[ln * 32 + hi] = 1; );
          ui_active = 66; ui_sqmode = edge ? 3 : 5; ui_sqln = ln; ui_sqi = hi; ui_sqx0 = mouse_x; ui_sqy0 = mouse_y; ui_sqpcm = mouse_cap & 4; ui_sqpsh = mouse_cap & 8;
          ui_sqs0 = p[2 + hi * 3]; ui_sqv0 = p[4 + hi * 3];
        );
      );
    );
    hov && ui_rpress && ui_active == 0 && hi >= 0 ? ( ui_sqpush(); ui_sqdel(ln, hi); );

    // drag
    ui_active == 66 && ui_down ? (
      p = ui_sqlane(ui_sqln); i = ui_sqi; k = p + 2 + i * 3;
      dx = mouse_x - ui_sqx0; dy = mouse_y - ui_sqy0;
