        ui_sqmarq(max(0, min(nl - 1, floor((min(mouse_y, ui_sqy0) - gy) / rh))), max(0, min(nl - 1, floor((max(mouse_y, ui_sqy0) - gy) / rh))), min(t, ui_sqpt), max(t, ui_sqpt), ui_sqpcm);
      ) :
