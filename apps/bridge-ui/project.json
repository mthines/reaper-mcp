{
  "name": "bridge-ui",
  "sourceRoot": "apps/bridge-ui/src",
  "projectType": "application",
  "tags": [
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/bridge-ui/build.mjs",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/apps/reaper-mcp-server/package.json",
        "{workspaceRoot}/apps/reaper-mcp-server/src/tools/knowledge.ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/bridge-ui"
      ]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 6006 --no-open",
        "cwd": "apps/bridge-ui"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build -o ../../dist/storybook/bridge-ui --quiet",
        "cwd": "apps/bridge-ui"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/apps/reaper-mcp-server/package.json",
        "{workspaceRoot}/apps/reaper-mcp-server/src/tools/knowledge.ts",
        "{workspaceRoot}/apps/reaper-mcp-server/src/telemetry-consent.ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/storybook/bridge-ui"
      ],
      "cache": true
    }
  }
}
